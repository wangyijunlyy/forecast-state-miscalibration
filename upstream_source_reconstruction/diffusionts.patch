+    echo "horizon_semantics=forecast gap/offset passed to torch_timeseries dataloader; prediction length remains steps=pred_len"
+    echo "train_val_test_split=repository dataloader defaults; ETT uses ETTH/ETTM fixed split, others use SlidingWindowTS train_ratio/test_ratio defaults"
+    echo "DiffusionTSBaselineBatchSize=$BATCH_SIZE"
+    echo "SPARCPITDataloaderBatchSize=$BATCH_SIZE"
