+sparc_min_delta: $SPARC_MIN_DELTA
+cache_dtype: "float16"
+cache_sorted_samples: false
+git_commit: "$GIT_COMMIT"
+YAML
+}
+
+run_baseline_attempt() {
+  local label="$1" dataset="$2" gpu="$3" batch="$4" chunk="$5" log="$6"
+  echo "START_BASELINE label=$label dataset=$dataset seed=1 gpu=$gpu batch=$batch chunk=$chunk" | tee -a "$log"
+  CUDA_VISIBLE_DEVICES="$gpu" PYTHONUNBUFFERED=1 python -u ./src/experiments/DiffusionTS.py \
+    --dataset_type="$dataset" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --horizon="$HORIZON" \
+    --pred_len="$PRED_LEN" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --lr="$LR" \
+    --num_worker="$NUM_WORKERS" \
+    --num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --sample_chunk_size="$chunk" \
+    --minisample="$chunk" \
+    --timesteps="$TIMESTEPS" \
+    --sampling_timesteps="$SAMPLING_TIMESTEPS" \
+    --beta_schedule="linear" \
+    --beta_start=0.0001 \
+    --beta_end=0.02 \
+    --scale_betas=False \
+    --train_ratio="$TRAIN_RATIO" \
+    --test_ratio="$TEST_RATIO" \
+    runs --seeds="[1]" >> "$log" 2>&1
+}
+
+run_sparc_attempt() {
+  local label="$1" dataset="$2" gpu="$3" batch="$4" chunk="$5" ckpt="$6" log="$7"
+  local out_dir="$OUT_ROOT/results/$label/sparc_pit_seed1"
+  mkdir -p "$out_dir"
+  echo "START_SPARC label=$label dataset=$dataset seed=1 gpu=$gpu batch=$batch chunk=$chunk checkpoint=$ckpt" | tee -a "$log"
+  CUDA_VISIBLE_DEVICES="$gpu" PYTHONUNBUFFERED=1 python -u ./src/experiments/DiffusionTS_SPARC_PIT.py \
+    --dataset_type="$dataset" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --horizon="$HORIZON" \
+    --pred_len="$PRED_LEN" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --lr="$LR" \
+    --num_worker="$NUM_WORKERS" \
+    --num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --sample_chunk_size="$chunk" \
+    --minisample="$chunk" \
+    --pit_sample_batch_size="$PIT_SAMPLE_BATCH_SIZE" \
+    --time_chunk_size=48 \
+    --feature_chunk_size=64 \
+    --calibrator_micro_batch_size=1 \
+    --timesteps="$TIMESTEPS" \
+    --sampling_timesteps="$SAMPLING_TIMESTEPS" \
+    --beta_schedule="linear" \
+    --beta_start=0.0001 \
+    --beta_end=0.02 \
+    --scale_betas=False \
+    --train_ratio="$TRAIN_RATIO" \
+    --test_ratio="$TEST_RATIO" \
+    --checkpoint_dir="$ckpt" \
+    --output_dir="$out_dir" \
+    --cache_dir="$OUT_ROOT/cache" \
+    --eval_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --stats_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --pit_fit_num_samples="$PIT_FIT_NUM_SAMPLES" \
+    --val_num_samples="$VAL_NUM_SAMPLES" \
+    --final_test_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --sparc_epochs="$SPARC_EPOCHS" \
+    --sparc_patience="$SPARC_PATIENCE" \
+    --sparc_min_delta="$SPARC_MIN_DELTA" \
+    --limit_train_batches="$LIMIT_TRAIN_BATCHES" \
+    --limit_pit_fit_batches="$LIMIT_PIT_FIT_BATCHES" \
+    --limit_val_batches="$LIMIT_VAL_BATCHES" \
+    --cache_dtype="float16" \
+    --cache_sorted_samples=False \
+    --config_hash="$RUN_ID-$label-seed1" \
+    --git_commit="$GIT_COMMIT" \
+    run --seed=1 >> "$log" 2>&1
+}
+
+metrics_to_json() {
+  local label="$1" dataset="$2" stage="$3" log="$4" ckpt="${5:-}" auto_baseline="${6:-false}" status="${7:-ok}"
+  python scripts/DiffusionTS/extract_seed1_four_metrics.py \
+    --label "$label" \
+    --dataset-type "$dataset" \
+    --stage "$stage" \
+    --log "$log" \
+    --out-root "$OUT_ROOT" \
+    --checkpoint "$ckpt" \
+    --auto-baseline "$auto_baseline" \
+    --status "$status" || true
+}
+
+run_with_oom_fallback() {
+  local kind="$1" label="$2" dataset="$3" gpu="$4" ckpt="${5:-}" auto_baseline="${6:-false}"
+  local log="$OUT_ROOT/logs/${label}_${kind}_seed1.log"
+  local peak="$OUT_ROOT/logs/${label}_${kind}_seed1.peak"
+  : > "$log"
+  local batches=(32 16 8)
+  local chunks=(4 2 1)
+  for batch in "${batches[@]}"; do
+    for chunk in "${chunks[@]}"; do
+      write_resolved_config "$label" "$dataset" "$kind" "$gpu" "$batch" "$chunk" "$ckpt"
+      set +e
+      if [[ "$kind" == "baseline" ]]; then
+        run_baseline_attempt "$label" "$dataset" "$gpu" "$batch" "$chunk" "$log" &
+      else
+        run_sparc_attempt "$label" "$dataset" "$gpu" "$batch" "$chunk" "$ckpt" "$log" &
+      fi
+      local pid=$!
+      echo "$pid" > "$OUT_ROOT/status/${label}_${kind}_seed1.pid"
+      monitor_gpu "$pid" "$gpu" "$log" "$peak" &
+      local mon=$!
+      wait "$pid"
+      local rc=$?
+      kill "$mon" 2>/dev/null || true
+      set -e
+      if [[ "$rc" -eq 0 ]]; then
+        echo "DONE_${kind^^} label=$label batch=$batch chunk=$chunk" | tee -a "$log"
+        metrics_to_json "$label" "$dataset" "$kind" "$log" "$ckpt" "$auto_baseline" "ok"
+        return 0
+      fi
+      if grep -E "OutOfMemory|CUDA out of memory|CUBLAS_STATUS_ALLOC_FAILED|GPU_HARD_LIMIT" "$log" >/dev/null 2>&1; then
+        echo "OOM_FALLBACK label=$label kind=$kind batch=$batch chunk=$chunk" | tee -a "$log"
+        continue
+      fi
+      echo "FAILED_NON_OOM label=$label kind=$kind batch=$batch chunk=$chunk rc=$rc" | tee -a "$log"
+      metrics_to_json "$label" "$dataset" "$kind" "$log" "$ckpt" "$auto_baseline" "failed"
+      return "$rc"
+    done
+  done
+  echo "FAILED_ALL_OOM_FALLBACKS label=$label kind=$kind" | tee -a "$log"
+  metrics_to_json "$label" "$dataset" "$kind" "$log" "$ckpt" "$auto_baseline" "oom_failed"
+  return 1
+}
+
+dataset_worker() {
+  local label="$1" dataset="$2" gpu="$3"
+  local lock="$OUT_ROOT/status/${label}_seed1.lock"
+  local done="$OUT_ROOT/status/${label}_seed1.DONE"
+  local failed="$OUT_ROOT/status/${label}_seed1.FAILED"
+  local pidfile="$OUT_ROOT/status/${label}_seed1.worker.pid"
+  if [[ -f "$done" ]]; then
+    echo "SKIP_DONE label=$label done=$done"
+    return 0
+  fi
+  if [[ -f "$pidfile" ]]; then
+    local old
+    old="$(cat "$pidfile" || true)"
+    if [[ "$old" =~ ^[0-9]+$ ]] && kill -0 "$old" 2>/dev/null; then
+      echo "REFUSE_DUPLICATE label=$label pid=$old"
+      return 1
+    fi
+  fi
+  echo "$BASHPID" > "$lock"
+  echo "$BASHPID" > "$pidfile"
+  rm -f "$failed"
+
+  local auto_baseline=false
+  local ckpt
+  if ckpt="$(resolve_seed1_checkpoint "$label" "$dataset")"; then
+    echo "CHECKPOINT_FOUND label=$label dataset=$dataset checkpoint=$ckpt"
+  else
+    auto_baseline=true
+    echo "BASELINE_MISSING label=$label dataset=$dataset action=train_seed1_baseline" | tee "$OUT_ROOT/status/${label}_baseline_missing.txt"
+    if ! run_with_oom_fallback baseline "$label" "$dataset" "$gpu" "" "$auto_baseline"; then
+      date -Is > "$failed"
+      rm -f "$lock"
+      return 1
+    fi
+    ckpt="$(latest_checkpoint_any "$dataset")"
+    if [[ -z "$ckpt" ]] || [[ ! -s "$(checkpoint_file_for_dir "$ckpt" 2>/dev/null || true)" ]]; then
+      echo "FAILED checkpoint_not_created label=$label dataset=$dataset" | tee -a "$OUT_ROOT/logs/${label}_baseline_seed1.log"
+      date -Is > "$failed"
+      rm -f "$lock"
+      return 1
+    fi
+  fi
+  echo "$ckpt" > "$OUT_ROOT/status/${label}_seed1_baseline_checkpoint.txt"
+  mkdir -p "$OUT_ROOT/results/$label"
+  sha256sum "$(checkpoint_file_for_dir "$ckpt")" > "$OUT_ROOT/results/$label/seed1_checkpoint.sha256"
+  metrics_to_json "$label" "$dataset" "baseline" "$ckpt/output.log" "$ckpt" "$auto_baseline" "ok"
+  if ! run_with_oom_fallback sparc "$label" "$dataset" "$gpu" "$ckpt" "$auto_baseline"; then
+    date -Is > "$failed"
+    rm -f "$lock"
+    return 1
+  fi
+  date -Is > "$done"
+  rm -f "$lock"
+  return 0
+}
+
+make_summary() {
+  python scripts/DiffusionTS/summarize_seed1_four.py --out-root "$OUT_ROOT" || true
+}
+
+echo "PREFLIGHT_GPU"
+nvidia-smi
+nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits
+echo "PREFLIGHT_PROCESSES"
+ps -u wyj -o pid,ppid,stat,etime,cmd --forest
+echo "PREFLIGHT_CHECKPOINTS"
+for i in "${!DATASET_LABELS[@]}"; do
+  label="${DATASET_LABELS[$i]}"
+  dataset="${DATASET_TYPES[$i]}"
+  if ckpt="$(resolve_seed1_checkpoint "$label" "$dataset")"; then
+    echo "$label | $dataset | checkpoint_found | $ckpt"
+  else
+    echo "$label | $dataset | baseline_missing | will_train_seed1"
+  fi
+done
+
+GPU_ASSIGNMENTS=(0 1 2 3)
+echo "Dataset | DatasetType | GPU | Status"
+for i in "${!DATASET_LABELS[@]}"; do
+  echo "${DATASET_LABELS[$i]} | ${DATASET_TYPES[$i]} | ${GPU_ASSIGNMENTS[$i]} | queued"
+done
+
+pids=()
+for i in "${!DATASET_LABELS[@]}"; do
+  dataset_worker "${DATASET_LABELS[$i]}" "${DATASET_TYPES[$i]}" "${GPU_ASSIGNMENTS[$i]}" &
+  pids+=("$!")
+done
+
+echo "Dataset | DatasetType | GPU | Worker PID | Log root"
+for i in "${!DATASET_LABELS[@]}"; do
+  echo "${DATASET_LABELS[$i]} | ${DATASET_TYPES[$i]} | ${GPU_ASSIGNMENTS[$i]} | ${pids[$i]} | $OUT_ROOT/logs"
+done
+
+status=0
+for pid in "${pids[@]}"; do
+  if ! wait "$pid"; then
+    status=1
+  fi
+done
+make_summary
+echo "ALL_DONE status=$status run_id=$RUN_ID out_root=$OUT_ROOT"
+exit "$status"
