+            nn.ReLU(),
+            nn.Linear(configs.d_model, configs.d_model)
+        )
+
+    def KL_loss_normal(self, posterior_mean, posterior_logvar):
+        KL = -0.5 * torch.mean(1 - posterior_mean ** 2 + posterior_logvar -
