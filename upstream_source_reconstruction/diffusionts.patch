+echo "Traffic | 1 | ${TRAFFIC_GPU} | pending | 16 | 20 | ${EXT_ROOT}/cache/diffusionts_sparc_pit | $(df -h "$EXT_ROOT" | awk 'NR==2{print $4}') | ready"
