@@ -0,0 +1,58 @@
+import torch
+
+from src.sparc_pit.calibration import SampleSPARCCalibrator
+
+
+def main():
+    torch.manual_seed(7)
+    calibrator = SampleSPARCCalibrator(
+        prediction_length=8,
+        target_dim=6,
+        hidden_dim=16,
+        mean_correction=False,
+    )
+    optimizer = torch.optim.Adam(calibrator.parameters(), lr=1e-3)
+    base = torch.randn(2, 5, 8, 6)
+    aug = base + 0.05 * torch.randn_like(base)
+    target = torch.randn(2, 8, 6)
+
+    optimizer.zero_grad()
+    full_loss = calibrator.loss(base, aug, target)
+    full_loss.backward()
+    full_grad = sum(
+        p.grad.detach().abs().sum().item()
+        for p in calibrator.parameters()
+        if p.grad is not None
+    )
+
+    optimizer.zero_grad()
+    total = 0.0
+    for t0 in range(0, 8, 4):
+        for f0 in range(0, 6, 3):
+            t1 = min(8, t0 + 4)
+            f1 = min(6, f0 + 3)
+            block_loss = calibrator.loss(
+                base[:, :, t0:t1, f0:f1],
+                aug[:, :, t0:t1, f0:f1],
+                target[:, t0:t1, f0:f1],
+                horizon_offset=t0,
+            )
+            weight = ((t1 - t0) * (f1 - f0)) / (8 * 6)
+            weighted = block_loss * weight
+            weighted.backward()
+            total += float(weighted.detach())
+    chunk_grad = sum(
+        p.grad.detach().abs().sum().item()
+        for p in calibrator.parameters()
+        if p.grad is not None
+    )
+
+    assert torch.isfinite(full_loss), full_loss
+    assert torch.isfinite(torch.tensor(total)), total
+    assert full_grad > 0
+    assert chunk_grad > 0
+    print(f"CHUNKED_CALIBRATOR_TEST_OK full_loss={float(full_loss):.6f} chunk_loss={total:.6f} full_grad={full_grad:.6f} chunk_grad={chunk_grad:.6f}")
+
+
+if __name__ == "__main__":
+    main()
