+set -euo pipefail
+
+ROOT="${ROOT:-$HOME/SPARC/NsDiff_DiffusionTS_SPARC_PIT_20260716}"
+cd "$ROOT"
+
+mkdir -p logs/gate logs/smoke results reports checkpoints cache runs/status
+
+source "$HOME/miniconda3/etc/profile.d/conda.sh"
+conda activate k2vae
+
+export PYTHONPATH=./
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export TMDM_METRIC_WORKERS=8
+
+SEED=1
+WINDOWS=168
+HORIZON=1
+BATCH_SIZE=32
+EPOCHS=10
+PATIENCE=5
+LR=0.001
+TIMESTEPS=20
+SAMPLING_TIMESTEPS=20
+NUM_SAMPLES=100
+SAMPLE_CHUNK_SIZE=20
+NUM_WORKERS=8
+GIT_COMMIT="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
+CONFIG_HASH="$(
+  printf 'windows=%s horizon=%s batch=%s epochs=%s patience=%s lr=%s timesteps=%s sampling=%s samples=%s chunk=%s seed=%s beta=linear-0.0001-0.02\n' \
+    "$WINDOWS" "$HORIZON" "$BATCH_SIZE" "$EPOCHS" "$PATIENCE" "$LR" "$TIMESTEPS" "$SAMPLING_TIMESTEPS" "$NUM_SAMPLES" "$SAMPLE_CHUNK_SIZE" "$SEED" \
+    | sha256sum | awk '{print $1}'
+)"
+
+cat > runs/status/gate_config.json <<JSON
+{
+  "config_hash": "$CONFIG_HASH",
+  "git_commit": "$GIT_COMMIT",
+  "seq_len": $WINDOWS,
+  "pred_len_default": 192,
