+    # # mu_tilde = (Sigma_1*Sigma_2)/(at * Sigma_2 + Sigma_1)
+    # Sigma_1 = 1 - at
+    # Sigma_2 = 1 - at_bar_prev
+    return at, at_bar, at_tilde, Sigma_1, Sigma_2
