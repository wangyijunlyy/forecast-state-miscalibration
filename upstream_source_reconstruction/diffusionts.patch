+    if ! ckpt="$(seed_checkpoint "$label" "$seed")"; then
+      echo "MISSING_BASELINE_CHECKPOINT label=${label} seed=${seed}; not using another seed checkpoint" | tee -a "$log"
+      echo "missing baseline checkpoint" > "$failedfile"
+      continue
+    fi
+    if ! checkpoint_file_for_dir "$ckpt" >/dev/null 2>&1 || [[ ! -s "$(checkpoint_file_for_dir "$ckpt")" ]]; then
+      echo "INVALID_BASELINE_CHECKPOINT label=${label} seed=${seed} ckpt=${ckpt}" | tee -a "$log"
+      echo "invalid baseline checkpoint" > "$failedfile"
+      continue
+    fi
+    rm -f "$failedfile" "$lockfile"
+    echo "$BASHPID" > "$lockfile"
+    echo "$BASHPID" > "$pidfile"
+    local success=0
+    for pit_batch in $pit_batches; do
+      for chunk in $chunks; do
+        local attempt_log="$EXT_ROOT/logs/${label,,}_seed${seed}_chunk${chunk}_pit${pit_batch}.log"
+        local peak_file="$EXT_ROOT/logs/${label,,}_seed${seed}_chunk${chunk}_pit${pit_batch}.peak"
+        echo "Dataset | Seed | GPU | PID | Chunk | PIT batch | Cache path | Disk free | Status"
+        echo "${label} | ${seed} | ${gpu} | pending | ${chunk} | ${pit_batch} | ${EXT_ROOT}/cache/diffusionts_sparc_pit | $(df -h "$EXT_ROOT" | awk 'NR==2{print $4}') | launching"
