-        super().__init__()
-        self.hurwitz = hurwitz
-        self.tie_state = tie_state
-        self.verbose = verbose
-
-        # Rank of low-rank correction
-        self.rank = P.shape[-2]
-        assert w.size(-1) == P.size(-1) == B.size(-1) == C.size(-1)
-        self.H = log_dt.size(-1)
-        self.N = w.size(-1)
-
-        # Broadcast everything to correct shapes
