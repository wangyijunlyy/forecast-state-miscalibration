+    def _train(self):
+        with torch.enable_grad(), tqdm(total=len(self.train_loader.dataset)) as progress_bar:
+            self.model.train()
+            train_loss = []
+            for i, (
+                batch_x,
+                batch_y,
+                origin_x,
+                origin_y,
+                batch_x_date_enc,
+                batch_y_date_enc,
+            ) in enumerate(self.train_loader):
