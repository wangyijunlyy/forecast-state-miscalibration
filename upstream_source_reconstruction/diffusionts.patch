+  "horizon": $HORIZON,
+  "horizon_semantics": "Passed to ETTHLoader/ETTMLoader/SlidingWindowTS as forecast gap/offset; prediction length is independently controlled by steps=pred_len.",
+  "epochs": $EPOCHS,
+  "learning_rate": $LR,
+  "batch_size": $BATCH_SIZE,
+  "diffusion_timesteps": $TIMESTEPS,
+  "sampling_timesteps": $SAMPLING_TIMESTEPS,
+  "beta_schedule": "linear",
+  "beta_start": 0.0001,
+  "beta_end": 0.02,
+  "num_samples": $NUM_SAMPLES,
