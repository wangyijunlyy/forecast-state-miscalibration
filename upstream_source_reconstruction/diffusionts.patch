+
+        tau = self.tau_learner(x_raw, std_enc).exp()  # B x S x E, B x 1 x E -> B x 1, positive scalar
+        delta = self.delta_learner(x_raw, mean_enc)  # B x S x E, B x 1 x E -> B x S
+
+        # Model Inference
+        enc_out = self.enc_embedding(x_enc, x_mark_enc)
