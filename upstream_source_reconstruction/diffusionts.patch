+#!/usr/bin/env python3
+from __future__ import annotations
+
+import ast
+import csv
+import json
+import re
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+RESULTS = ROOT / "results"
+REPORTS = ROOT / "reports"
+
+DATASETS = [
+    ("ECL", "Electricity", 192),
+    ("Traffic", "Traffic", 192),
+]
+
+
+def parse_metrics_from_log(path: Path) -> dict[str, float] | None:
+    found = None
+    if not path.exists():
+        return None
+    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
+        if "test_results:" not in line:
+            continue
+        payload = line.split("test_results:", 1)[1].strip()
+        try:
+            found = ast.literal_eval(payload)
+        except (SyntaxError, ValueError):
+            pass
+    return found
+
+
+def parse_metrics_file(path: Path) -> dict[str, float] | None:
+    if not path.exists():
+        return None
+    text = path.read_text(encoding="utf-8", errors="ignore").strip()
+    if not text:
+        return None
+    try:
+        return ast.literal_eval(text.splitlines()[-1])
+    except (SyntaxError, ValueError):
+        return None
+
+
+def latest_baseline(dataset: str, pred_len: int) -> tuple[Path | None, dict[str, float] | None]:
+    base = RESULTS / "runs" / "DiffusionTS" / dataset / f"w168h1s{pred_len}"
+    logs = sorted(base.glob("*/output.log"), key=lambda p: p.stat().st_mtime if p.exists() else 0)
+    for log in reversed(logs):
+        metrics = parse_metrics_from_log(log)
+        if metrics:
+            return log.parent, metrics
+    return None, None
+
+
+def latest_sparc(dataset: str, pred_len: int) -> tuple[Path | None, dict[str, float] | None]:
+    base = RESULTS / "sparc_pit" / f"DiffusionTS_{dataset}_w168h1s{pred_len}_seed1_gate"
+    metrics = parse_metrics_file(base / "sparc_pit_test_metrics.txt")
+    return (base, metrics) if metrics else (None, None)
+
+
+def read_text(path: Path) -> str:
+    return path.read_text(encoding="utf-8", errors="ignore") if path.exists() else ""
+
+
+def runtime_seconds(log: Path) -> str:
+    text = read_text(log)
+    m = re.search(r"RUNTIME_SECONDS=(\d+)", text)
+    return m.group(1) if m else ""
+
+
+def best_epoch(log: Path) -> str:
+    text = read_text(log)
+    epochs = re.findall(r"Epoch:\s+(\d+)", text)
+    return epochs[-1] if epochs else ""
+
+
+def peak_mem(path: Path) -> str:
+    text = read_text(path).strip()
+    return text or ""
+
+
+def row(dataset_label: str, dataset: str, method: str, metrics: dict[str, float] | None, path: Path | None, log: Path, peak: Path, config_hash: str) -> dict[str, str | float]:
+    status = "ok" if metrics else "missing"
+    qice = metrics.get("qice", "") if metrics else ""
+    return {
+        "Dataset": dataset_label,
+        "Seed": 1,
+        "Method": method,
+        "CRPS": metrics.get("crps", "") if metrics else "",
+        "QICE_raw": qice,
+        "QICE_paper_scale": (qice * 100.0) if isinstance(qice, float) else "",
+        "MSE": metrics.get("mse", "") if metrics else "",
+        "MAE": metrics.get("mae", "") if metrics else "",
+        "RuntimeSeconds": runtime_seconds(log),
+        "PeakGPUMemoryMiB": peak_mem(peak),
+        "TrainBatchSize": 32,
+        "EvalBatchSize": 32,
+        "SampleChunkSize": 20,
+        "NumSamples": 100,
+        "BestEpoch": best_epoch(log),
+        "CheckpointPath": str(path or ""),
+        "ConfigHash": config_hash,
+        "Status": status,
+    }
+
+
+def main() -> None:
+    RESULTS.mkdir(exist_ok=True)
+    REPORTS.mkdir(exist_ok=True)
+    meta_path = ROOT / "runs" / "status" / "gate_config.json"
+    meta = json.loads(meta_path.read_text(encoding="utf-8")) if meta_path.exists() else {}
+    config_hash = meta.get("config_hash", "")
+
+    rows = []
+    for label, dataset, pred_len in DATASETS:
+        base_path, base_metrics = latest_baseline(dataset, pred_len)
+        sparc_path, sparc_metrics = latest_sparc(dataset, pred_len)
+        rows.append(row(label, dataset, "DiffusionTS", base_metrics, base_path, ROOT / "logs" / "gate" / f"{label}_baseline_seed1.log", ROOT / "logs" / "gate" / f"{label}_baseline_seed1.peak", config_hash))
+        rows.append(row(label, dataset, "DiffusionTS-SPARC-PIT", sparc_metrics, sparc_path, ROOT / "logs" / "gate" / f"{label}_sparc_seed1.log", ROOT / "logs" / "gate" / f"{label}_sparc_seed1.peak", config_hash))
+
+    raw_path = RESULTS / "ecl_traffic_seed1_raw.csv"
+    comparison_path = RESULTS / "ecl_traffic_seed1_comparison.csv"
+    fields = [
+        "Dataset", "Seed", "Method", "CRPS", "QICE_raw", "QICE_paper_scale", "MSE", "MAE",
+        "RuntimeSeconds", "PeakGPUMemoryMiB", "TrainBatchSize", "EvalBatchSize", "SampleChunkSize",
+        "NumSamples", "BestEpoch", "CheckpointPath", "ConfigHash", "Status",
+    ]
+    for path in (raw_path, comparison_path):
+        with path.open("w", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=fields)
+            writer.writeheader()
+            writer.writerows(rows)
+
+    gate_ok = all(r["Status"] == "ok" for r in rows)
+    cache_hit_count = sum(read_text(ROOT / "logs" / "gate" / f"{label}_sparc_seed1.log").count("CACHE HIT") for label, _dataset, _pred in DATASETS)
+    report = [
+        "# ECL/Traffic Seed 1 Gate",
+        "",
+        f"- Gate status: {'PASS' if gate_ok and cache_hit_count > 0 else 'PENDING_OR_FAIL'}",
+        "- QICE_raw is decimal scale; QICE_paper_scale = QICE_raw * 100.",
+        f"- CACHE HIT count in SPARC logs: {cache_hit_count}",
+        f"- Raw CSV: {raw_path}",
+        f"- Comparison CSV: {comparison_path}",
+        "",
+        "No seed averaging is performed in this gate report.",
+    ]
+    (REPORTS / "ECL_TRAFFIC_SEED1_GATE.md").write_text("\n".join(report) + "\n", encoding="utf-8")
+    print(REPORTS / "ECL_TRAFFIC_SEED1_GATE.md")
+
+
+if __name__ == "__main__":
+    main()
