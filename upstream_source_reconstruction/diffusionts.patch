+      --epochs="$EPOCHS" \
+      --patience="$PATIENCE" \
+      --lr="$LR" \
+      --num_worker="$NUM_WORKERS" \
+      --num_samples="$NUM_SAMPLES" \
+      --sample_chunk_size="$SAMPLE_CHUNK_SIZE" \
+      --minisample="$SAMPLE_CHUNK_SIZE" \
+      --timesteps="$TIMESTEPS" \
+      --sampling_timesteps="$SAMPLING_TIMESTEPS" \
+      --beta_schedule="linear" \
+      --beta_start=0.0001 \
+      --beta_end=0.02 \
+      --scale_betas=False \
