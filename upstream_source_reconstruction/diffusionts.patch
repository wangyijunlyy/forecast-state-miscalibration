+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import ast
+import csv
+import json
+import math
+import re
+from pathlib import Path
+from statistics import mean, pstdev
+
+ROOT = Path(__file__).resolve().parents[2]
+RESULTS = ROOT / "results"
+ARTIFACTS = ROOT / "artifacts"
+
+DATASETS = {
+    "ECL": {"dataset_type": "Electricity", "paper_crps": 0.633, "paper_qice": 8.205, "gpu": 2},
+    "Traffic": {"dataset_type": "Traffic", "paper_crps": 0.668, "paper_qice": 5.958, "gpu": 3},
+}
+
+
+def parse_metrics_text(text: str) -> dict[str, float] | None:
+    found = None
+    for line in text.splitlines():
+        if "test_results:" in line:
+            payload = line.split("test_results:", 1)[1].strip()
+        elif line.startswith("{") and line.endswith("}"):
+            payload = line
+        else:
+            continue
+        try:
+            parsed = ast.literal_eval(payload)
+            if isinstance(parsed, dict) and "crps" in parsed:
+                found = {k: float(v) for k, v in parsed.items()}
+        except Exception:
+            continue
+    return found
+
+
+def read_text(path: Path) -> str:
+    return path.read_text(encoding="utf-8", errors="ignore") if path.exists() else ""
+
+
+def baseline_dir(dataset_type: str, seed: int) -> Path | None:
+    base = RESULTS / "runs" / "DiffusionTS" / dataset_type / "w168h1s192"
+    if not base.exists():
+        return None
+    candidates = sorted([p for p in base.iterdir() if p.is_dir() and f"seed-{seed}" in p.name], key=lambda p: p.stat().st_mtime)
+    return candidates[-1] if candidates else None
+
+
+def baseline_metrics(dataset_type: str, seed: int) -> tuple[Path | None, dict[str, float] | None]:
+    path = baseline_dir(dataset_type, seed)
+    if not path:
+        return None, None
+    return path, parse_metrics_text(read_text(path / "output.log"))
+
+
+def sparc_dir(dataset_type: str, seed: int) -> Path:
+    return RESULTS / "sparc_pit" / f"DiffusionTS_{dataset_type}_w168h1s192_seed{seed}_validation"
+
+
+def sparc_metrics(dataset_type: str, seed: int) -> tuple[Path, dict[str, float] | None]:
+    path = sparc_dir(dataset_type, seed)
+    return path, parse_metrics_text(read_text(path / "sparc_pit_test_metrics.txt"))
+
+
+def stats(values: list[float]) -> dict[str, float]:
+    clean = [v for v in values if isinstance(v, (int, float)) and math.isfinite(v)]
+    if not clean:
+        return {"mean": float("nan"), "std": float("nan")}
+    return {"mean": mean(clean), "std": pstdev(clean) if len(clean) > 1 else 0.0}
+
+
+def summarize_method(seed_rows: list[dict], method: str) -> dict:
+    rows = [r for r in seed_rows if r["method"] == method and r["status"] == "ok"]
+    out = {"method": method, "seeds_completed": len(rows)}
+    for key in ("crps", "qice", "mse", "mae"):
+        s = stats([r[key] for r in rows])
+        out[f"{key}_mean"] = s["mean"]
+        out[f"{key}_std"] = s["std"]
+    return out
+
+
+def checkpoint_hash(label: str, seed: int) -> str:
+    path = RESULTS / label / f"seed{seed}_checkpoint.sha256"
+    text = read_text(path).strip()
+    return text.split()[0] if text else ""
+
+
+def runtime_seconds(log: Path, prefix: str, seed: int) -> int | None:
+    text = read_text(log)
+    pattern = rf"{prefix}_RUNTIME_SECONDS seed={seed} seconds=(\d+)"
+    m = re.search(pattern, text)
+    return int(m.group(1)) if m else None
+
+
+def cache_counts(log: Path) -> tuple[int, int]:
+    text = read_text(log)
+    return text.count("[CACHE HIT]"), text.count("[CACHE MISS]")
+
+
+def write_dataset(label: str, run_id: str, seeds: list[int]) -> dict:
+    meta = DATASETS[label]
+    dataset_type = meta["dataset_type"]
+    log = ROOT / "logs" / ("validation_ecl.log" if label == "ECL" else "validation_traffic.log")
+    seed_rows = []
+    for seed in seeds:
+        b_path, b_metrics = baseline_metrics(dataset_type, seed)
+        s_path, s_metrics = sparc_metrics(dataset_type, seed)
+        for method, path, metrics in (
+            ("baseline", b_path, b_metrics),
+            ("sparc_pit", s_path, s_metrics),
+        ):
+            row = {
+                "dataset": label,
+                "dataset_type": dataset_type,
+                "seed": seed,
+                "method": method,
+                "status": "ok" if metrics else "missing",
+                "path": str(path or ""),
+                "checkpoint_hash": checkpoint_hash(label, seed),
+            }
+            for k in ("crps", "qice", "mse", "mae"):
+                row[k] = float(metrics[k]) if metrics and k in metrics else float("nan")
+            seed_rows.append(row)
+
+    baseline = summarize_method(seed_rows, "baseline")
+    sparc = summarize_method(seed_rows, "sparc_pit")
+    for summary in (baseline, sparc):
+        summary["paper_crps"] = meta["paper_crps"]
+        summary["paper_qice"] = meta["paper_qice"]
+        summary["crps_abs_diff_vs_paper"] = abs(summary["crps_mean"] - meta["paper_crps"])
+        summary["crps_rel_diff_vs_paper"] = summary["crps_abs_diff_vs_paper"] / meta["paper_crps"] if meta["paper_crps"] else float("nan")
+        qice_paper_scale = summary["qice_mean"] * 100.0
+        summary["qice_paper_scale_mean"] = qice_paper_scale
+        summary["qice_abs_diff_vs_paper"] = abs(qice_paper_scale - meta["paper_qice"])
+        summary["qice_rel_diff_vs_paper"] = summary["qice_abs_diff_vs_paper"] / meta["paper_qice"] if meta["paper_qice"] else float("nan")
+
+    hit, miss = cache_counts(log)
+    total_cache = hit + miss
+    out = {
+        "run_id": run_id,
+        "dataset": label,
+        "dataset_type": dataset_type,
+        "physical_gpu": meta["gpu"],
+        "cuda_visible_devices": str(meta["gpu"]),
+        "actual_batch_size": 32,
+        "sample_chunk_size": 10,
+        "test_num_samples": 100,
+        "peak_memory_mib": read_text(ROOT / "logs" / ("validation_ecl.peak" if label == "ECL" else "validation_traffic.peak")).strip(),
+        "cache_hits": hit,
+        "cache_misses": miss,
+        "cache_hit_rate": hit / total_cache if total_cache else 0.0,
+        "nan_or_inf_seen": bool(re.search(r"\b(nan|inf)\b", read_text(log), flags=re.IGNORECASE)),
+        "baseline": baseline,
+        "sparc_pit": sparc,
+        "seed_results": seed_rows,
+        "baseline_total_seconds": sum(x or 0 for x in (runtime_seconds(log, "BASELINE", seed) for seed in seeds)),
