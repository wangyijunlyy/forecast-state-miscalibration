+        else:
+            batch_y =torch.concat( [batch_x[:, -(self.windows - self.pred_len):, :], batch_y] , dim = 1 )
+            batch_y_date_enc =   torch.concat([batch_x_date_enc[:, -(self.windows - self.pred_len):, :], batch_y_date_enc], dim=1)
