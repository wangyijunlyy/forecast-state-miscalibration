+checkpoint_file_for_dir() {
+  local ckpt_dir="$1"
+  if [[ -f "$ckpt_dir/best_model.pth" ]]; then
+    printf '%s/best_model.pth\n' "$ckpt_dir"
+  elif [[ -f "$ckpt_dir/model.pth" ]]; then
+    printf '%s/model.pth\n' "$ckpt_dir"
+  else
+    return 1
+  fi
+}
+
+latest_checkpoint_any() {
+  local dataset="$1"
+  local base="results/runs/DiffusionTS/${dataset}/w${WINDOWS}h${HORIZON}s${PRED_LEN}"
+  find "$base" -type f \( -name best_model.pth -o -name model.pth \) -printf '%T@ %h\n' 2>/dev/null \
+    | sort -n | tail -n 1 | cut -d' ' -f2-
+}
+
+latest_checkpoint_after() {
+  local dataset="$1"
+  local since="$2"
+  local base="results/runs/DiffusionTS/${dataset}/w${WINDOWS}h${HORIZON}s${PRED_LEN}"
+  find "$base" -type f \( -name best_model.pth -o -name model.pth \) -newermt "@${since}" -printf '%T@ %h\n' 2>/dev/null \
+    | sort -n | tail -n 1 | cut -d' ' -f2-
+}
+
+resolve_seed1_checkpoint() {
+  local label="$1"
+  local dataset="$2"
+  local status_file="$OUT_ROOT/status/${label}_seed1_baseline_checkpoint.txt"
+  if [[ -s "$status_file" ]]; then
+    local ckpt
+    ckpt="$(cat "$status_file")"
+    if [[ -n "$ckpt" ]] && [[ -s "$(checkpoint_file_for_dir "$ckpt" 2>/dev/null || true)" ]]; then
+      printf '%s\n' "$ckpt"
+      return 0
+    fi
+  fi
+  local ckpt
+  ckpt="$(latest_checkpoint_any "$dataset")"
+  if [[ -n "$ckpt" ]] && [[ -s "$(checkpoint_file_for_dir "$ckpt" 2>/dev/null || true)" ]]; then
+    printf '%s\n' "$ckpt"
+    return 0
+  fi
+  return 1
+}
+
+gpu_used() {
+  nvidia-smi --id="$1" --query-gpu=memory.used --format=csv,noheader,nounits | tr -d ' '
+}
+
+gpu_total() {
+  nvidia-smi --id="$1" --query-gpu=memory.total --format=csv,noheader,nounits | tr -d ' '
+}
+
+monitor_gpu() {
+  local pid="$1"
+  local gpu="$2"
+  local log="$3"
+  local peak_file="$4"
+  local total
+  total="$(gpu_total "$gpu")"
+  local warn=$(( total * GPU_WARN_RATIO / 100 ))
+  local hard=$(( total * GPU_HARD_LIMIT_RATIO / 100 ))
+  local peak=0
+  while kill -0 "$pid" 2>/dev/null; do
+    local used
+    used="$(gpu_used "$gpu" 2>/dev/null || echo 0)"
+    if [[ "$used" =~ ^[0-9]+$ ]]; then
+      if (( used > peak )); then
+        peak="$used"
+        echo "$peak" > "$peak_file"
+      fi
+      if (( used >= warn )); then
+        echo "GPU_WARNING gpu=${gpu} used_mib=${used} warn_mib=${warn}" >> "$log"
+      fi
+      if (( used >= hard )); then
+        echo "GPU_HARD_LIMIT gpu=${gpu} used_mib=${used} hard_mib=${hard}" >> "$log"
+        kill "$pid" 2>/dev/null || true
+        return 0
+      fi
+    fi
+    sleep 30
+  done
+}
