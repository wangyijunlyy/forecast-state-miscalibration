+def get_stride_for_cell_type(cell_type):
+    if cell_type.startswith('normal') or cell_type.startswith('combiner'):
+        stride = 1
+    elif cell_type.startswith('down'):
+        stride = 2
+    elif cell_type.startswith('up'):
+        stride = -1
+    else:
+        raise NotImplementedError(cell_type)
