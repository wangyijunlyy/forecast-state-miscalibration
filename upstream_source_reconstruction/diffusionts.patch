+conda activate k2vae
+
+export PYTHONPATH=./
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export TMDM_METRIC_WORKERS=8
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+
+mkdir -p "$EXT_ROOT"/{cache,results,logs,checkpoints,runs/status,quarantine,tmp}
+touch "$EXT_ROOT/tmp/write_test"
+rm -f "$EXT_ROOT/tmp/write_test"
+
+WINDOWS=168
+PRED_LEN=192
+HORIZON=1
+BASELINE_BATCH_SIZE=32
+LR=0.001
+TIMESTEPS=20
+SAMPLING_TIMESTEPS=20
+PIT_FIT_NUM_SAMPLES=100
+VAL_NUM_SAMPLES=20
+FINAL_TEST_NUM_SAMPLES=100
+NUM_WORKERS=8
+TRAIN_RATIO=0.7
+TEST_RATIO=0.2
+SPARC_EPOCHS=5
+SPARC_PATIENCE=1
+SPARC_MIN_DELTA=0.0005
+LIMIT_TRAIN_BATCHES=50
+LIMIT_PIT_FIT_BATCHES=50
+LIMIT_VAL_BATCHES=20
+PIT_SAMPLE_BATCH_SIZE_DEFAULT=20
+GPU_HARD_LIMIT_RATIO=99
+RUN_ID="${RUN_ID:-sparc_export_$(date +%Y%m%d_%H%M%S)}"
+GIT_COMMIT="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
+CONFIG_HASH="$(
+  printf 'DiffusionTS-SPARC-PIT accelerated validation configuration datasets=ECL,Traffic seeds=1,2,3 windows=%s pred=%s lr=%s batch=%s timesteps=%s beta=linear-0.0001-0.02 pit=%s val=%s test=%s limits=%s,%s,%s sparc_epochs=%s patience=%s min_delta=%s\n' \
+    "$WINDOWS" "$PRED_LEN" "$LR" "$BASELINE_BATCH_SIZE" "$TIMESTEPS" \
+    "$PIT_FIT_NUM_SAMPLES" "$VAL_NUM_SAMPLES" "$FINAL_TEST_NUM_SAMPLES" \
+    "$LIMIT_TRAIN_BATCHES" "$LIMIT_PIT_FIT_BATCHES" "$LIMIT_VAL_BATCHES" \
+    "$SPARC_EPOCHS" "$SPARC_PATIENCE" "$SPARC_MIN_DELTA" | sha256sum | awk '{print $1}'
+)"
+
+main_log="$EXT_ROOT/logs/continue_ecl_traffic_sparc_${RUN_ID}.log"
+exec > >(tee -a "$main_log") 2>&1
+
+echo "RUN_ID=$RUN_ID"
+echo "EXT_ROOT=$EXT_ROOT"
+echo "CONFIG=DiffusionTS-SPARC-PIT accelerated validation configuration"
+echo "DISK_CHECK_BEGIN"
+df -hT
+df -i
+df -h /data /scratch /mnt /workspace /home /export 2>/dev/null || true
+echo "GPU_CHECK_BEGIN"
+nvidia-smi
+nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits
+echo "PROCESS_CHECK_BEGIN"
+ps -u wyj -o pid,ppid,stat,etime,cmd --forest
+
+python - <<'PY'
+from pathlib import Path
+import os, shutil
+try:
+    import torch
+except Exception:
+    torch = None
+root = Path("cache/diffusionts_sparc_pit")
+qroot = Path(os.environ.get("EXT_ROOT", "/export/wyj/NsDiff_DiffusionTS_SPARC_PIT_20260716_accel")) / "quarantine" / "root_cache_corrupt"
+qroot.mkdir(parents=True, exist_ok=True)
+if root.exists():
+    for path in root.rglob("*"):
+        if not path.is_file():
+            continue
+        bad = path.suffix in {".tmp", ".partial"} or path.name.endswith(".tmp") or path.name.endswith(".partial") or path.stat().st_size == 0
+        reason = "tmp_partial_or_zero"
+        if not bad and torch is not None and path.suffix == ".pt":
+            try:
+                obj = torch.load(path, map_location="cpu")
+                samples = obj.get("samples") if isinstance(obj, dict) else None
+                meta = obj.get("metadata", {}) if isinstance(obj, dict) else {}
+                expected = meta.get("num_samples")
+                if samples is None or (expected is not None and int(samples.shape[1]) != int(expected)):
+                    bad, reason = True, "completed_samples_mismatch"
+            except Exception as exc:
+                bad, reason = True, f"torch_load_failed:{exc}"
+        if bad:
+            rel = path.relative_to(root)
+            dest = qroot / rel
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            print(f"QUARANTINE_CACHE {path} -> {dest} reason={reason}", flush=True)
+            shutil.move(str(path), str(dest))
+PY
+
+mapfile -t GPU_LINES < <(nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits | awk -F, '{gsub(/ /,""); free=$3-$2; print free","$1","$2","$3","$4}' | sort -t, -k1,1nr)
+ECL_GPU="$(echo "${GPU_LINES[0]}" | cut -d, -f2)"
+TRAFFIC_GPU="$(echo "${GPU_LINES[1]}" | cut -d, -f2)"
+
+echo "Dataset | Physical GPU | Used MiB | Free MiB | Existing processes"
+for row in "ECL,$ECL_GPU" "Traffic,$TRAFFIC_GPU"; do
+  label="${row%,*}"
+  gpu="${row#*,}"
+  used="$(nvidia-smi --id="$gpu" --query-gpu=memory.used --format=csv,noheader,nounits | tr -d ' ')"
+  free="$(nvidia-smi --id="$gpu" --query-gpu=memory.free --format=csv,noheader,nounits | tr -d ' ')"
+  echo "$label | $gpu | $used | $free | see nvidia-smi"
+done
+
+checkpoint_file_for_dir() {
+  local ckpt_dir="$1"
+  if [[ -f "${ckpt_dir}/best_model.pth" ]]; then
+    printf '%s/best_model.pth\n' "$ckpt_dir"
+  elif [[ -f "${ckpt_dir}/model.pth" ]]; then
+    printf '%s/model.pth\n' "$ckpt_dir"
+  else
+    return 1
+  fi
+}
+
+seed_checkpoint() {
+  local label="$1"
+  local seed="$2"
+  local status_file
+  for status_file in \
+    "$EXT_ROOT/runs/status/${label}_seed${seed}_baseline_checkpoint.txt" \
+    "runs/status/${label}_seed${seed}_baseline_checkpoint.txt" \
+    "runs/status/${label}_baseline_checkpoint_seed${seed}.txt"; do
+    if [[ -s "$status_file" ]]; then
+      cat "$status_file"
+      return 0
+    fi
+  done
+  if [[ "$seed" == "1" && "$label" == "ECL" ]]; then
+    printf '%s\n' "results/runs/DiffusionTS/Electricity/w168h1s192/8d4e5fe9081d8da91bec81c52b7e8aac"
+    return 0
+  fi
+  if [[ "$seed" == "1" && "$label" == "Traffic" ]]; then
+    printf '%s\n' "results/runs/DiffusionTS/Traffic/w168h1s192/e5e44a81eea8217356b29267c86bd57b"
+    return 0
+  fi
+  return 1
+}
+
+monitor_gpu() {
+  local pid="$1"
+  local gpu="$2"
+  local log="$3"
+  local peak_file="$4"
+  local total
+  total="$(nvidia-smi --id="$gpu" --query-gpu=memory.total --format=csv,noheader,nounits | tr -d ' ')"
+  local hard=$(( total * GPU_HARD_LIMIT_RATIO / 100 ))
+  local warn=$(( total * 97 / 100 ))
+  local peak=0
+  while kill -0 "$pid" 2>/dev/null; do
+    local used
+    used="$(nvidia-smi --id="$gpu" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d ' ')"
+    if [[ "$used" =~ ^[0-9]+$ ]]; then
+      if (( used > peak )); then
+        peak="$used"
+        echo "$peak" > "$peak_file"
+      fi
+      if (( used >= warn )); then
+        echo "GPU_WARNING gpu=${gpu} used_mib=${used} warn_mib=${warn}" >> "$log"
+      fi
+      if (( used >= hard )); then
+        echo "GPU_HARD_LIMIT gpu=${gpu} used_mib=${used} hard_mib=${hard}" >> "$log"
+        kill "$pid" 2>/dev/null || true
+        return 0
+      fi
+    fi
+    sleep 30
+  done
+}
+
+write_resolved_config() {
+  local label="$1" dataset="$2" seed="$3" gpu="$4" chunk="$5" pit_batch="$6" ckpt="$7"
+  mkdir -p "$EXT_ROOT/results/${label}"
+  local ckpt_hash
+  ckpt_hash="$(sha256sum "$(checkpoint_file_for_dir "$ckpt")" | awk '{print $1}')"
+  cat > "$EXT_ROOT/results/${label}/sparc_seed${seed}_resolved_config.yaml" <<YAML
+configuration: "DiffusionTS-SPARC-PIT accelerated validation configuration"
+run_id: "${RUN_ID}"
+dataset_label: "${label}"
+dataset_type: "${dataset}"
+seed: ${seed}
