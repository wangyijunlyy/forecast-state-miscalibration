+import torch
+
+from src.models.DiffusionTS import Diffusion_TS
+
+
+def _tiny_model():
+    torch.manual_seed(7)
+    return Diffusion_TS(
+        seq_length=6,
+        feature_size=1,
+        n_layer_enc=1,
+        n_layer_dec=1,
+        d_model=8,
+        timesteps=20,
+        sampling_timesteps=2,
+        loss_type="l2",
+        beta_schedule="linear",
+        beta_start=0.0001,
+        beta_end=0.02,
+        scale_betas=False,
+        n_heads=1,
+        mlp_hidden_times=1,
+        eta=0.0,
+        attn_pd=0.0,
+        resid_pd=0.0,
+        kernel_size=1,
+        padding_size=0,
+        use_ff=True,
+        reg_weight=None,
+    )
+
+
+def test_linear_beta_schedule_uses_requested_unscaled_range():
+    model = _tiny_model()
+
+    assert torch.isclose(model.betas[0], torch.tensor(0.0001), atol=1e-8)
+    assert torch.isclose(model.betas[-1], torch.tensor(0.02), atol=1e-8)
+    assert torch.isfinite(model.alphas_cumprod).all()
+    assert torch.isfinite(model.sqrt_recip_alphas_cumprod).all()
+
+
+def test_sampling_does_not_mutate_weights_or_leave_parameter_grads():
+    model = _tiny_model()
+    model.train()
+    before_training_state = model.training
+    before_requires_grad = [p.requires_grad for p in model.parameters()]
+    before_weights = [p.detach().clone() for p in model.parameters()]
+
+    target = torch.randn(1, 6, 1)
+    partial_mask = torch.tensor([[[True], [True], [True], [False], [False], [False]]])
+    sample = model.fast_sample_infill(
+        shape=target.shape,
+        target=target,
+        partial_mask=partial_mask,
+        sampling_timesteps=2,
+        model_kwargs={"coef": 0.1, "learning_rate": 0.05},
+    )
+
+    assert torch.isfinite(sample).all()
+    assert model.training is before_training_state
+    assert [p.requires_grad for p in model.parameters()] == before_requires_grad
+    assert all(p.grad is None for p in model.parameters())
+    for before, after in zip(before_weights, model.parameters()):
+        assert torch.equal(before, after.detach())
