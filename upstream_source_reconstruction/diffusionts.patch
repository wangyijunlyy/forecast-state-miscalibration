+def average_params(params, is_distributed):
+    """ parameter averaging. """
+    if is_distributed:
+        size = float(dist.get_world_size())
+        for param in params:
+            dist.all_reduce(param.data, op=dist.ReduceOp.SUM)
+            param.data /= size
