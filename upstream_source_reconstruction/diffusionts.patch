+                                       output_dim=configs.seq_len)
+
+        self.z_mean = nn.Sequential(
+            nn.Linear(configs.d_model, configs.d_model),
+            nn.ReLU(),
+            nn.Linear(configs.d_model, configs.d_model)
+        )
+        self.z_logvar = nn.Sequential(
+            nn.Linear(configs.d_model, configs.d_model),
+            nn.ReLU(),
+            nn.Linear(configs.d_model, configs.d_model)
+        )
+
+        self.z_out = nn.Sequential(
