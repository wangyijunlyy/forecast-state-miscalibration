+    sparc_checkpoint_path: str = ""
+    pit_warp_path: str = ""
+
+    @staticmethod
+    def _resolve_model_path(root: Path) -> Path:
+        for filename in ("model.pth", "best_model.pth"):
+            path = root / filename
+            if path.exists():
+                return path
+        raise FileNotFoundError(f"Missing checkpoint file under {root}: expected model.pth or best_model.pth")
+
+    def _load_frozen_checkpoint(self) -> None:
+        if not self.checkpoint_dir:
+            raise ValueError("--checkpoint_dir is required for DiffusionTS-SPARC-PIT")
+        root = Path(self.checkpoint_dir).expanduser()
+        model_path = self._resolve_model_path(root)
+        self.baseline_checkpoint_path = model_path
+        self.baseline_checkpoint_sha256 = self._sha256_file(model_path)
+
+        self.model.load_state_dict(_torch_load(model_path, self.device))
+        self.model.eval()
+        for parameter in self.model.parameters():
+            parameter.requires_grad = False
+
+    @staticmethod
+    def _sha256_file(path: Path) -> str:
+        digest = hashlib.sha256()
+        with path.open("rb") as handle:
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                digest.update(chunk)
+        return digest.hexdigest()
+
+    def _cache_root(self) -> Path:
+        root = Path(self.cache_dir).expanduser()
+        root.mkdir(parents=True, exist_ok=True)
+        return root
+
+    def _tensor_digest(self, *tensors: torch.Tensor) -> str:
+        digest = hashlib.sha256()
+        for tensor in tensors:
+            arr = tensor.detach().to("cpu", dtype=torch.float32).contiguous().numpy()
+            digest.update(str(arr.shape).encode("utf-8"))
+            digest.update(arr.tobytes())
+        return digest.hexdigest()
+
+    def _cache_metadata(self, num_samples: int, sample_chunk_size: int, split: str, batch_index: int = None) -> dict:
+        return {
+            "dataset": self.dataset_type,
+            "split": split,
+            "seed": getattr(self, "_active_seed", None),
+            "batch_index": batch_index,
+            "baseline_checkpoint_path": str(getattr(self, "baseline_checkpoint_path", "")),
+            "baseline_checkpoint_sha256": getattr(self, "baseline_checkpoint_sha256", ""),
+            "input_length": self.windows,
+            "pred_len": self.pred_len,
+            "diffusion_timesteps": self.timesteps,
+            "sampling_timesteps": self.sampling_timesteps,
+            "beta_schedule": getattr(self, "beta_schedule", None),
+            "beta_start": getattr(self, "beta_start", None),
+            "beta_end": getattr(self, "beta_end", None),
+            "num_samples": num_samples,
+            "pit_fit_num_samples": self.pit_fit_num_samples,
+            "val_num_samples": self.val_num_samples,
+            "final_test_num_samples": self.final_test_num_samples,
+            "sample_chunk_size": sample_chunk_size,
+            "pit_sample_batch_size": self.pit_sample_batch_size,
+            "feature_dimension": self.dataset.num_features,
+            "cache_dtype": self.cache_dtype,
+            "cache_sorted_samples": self.cache_sorted_samples,
+            "config_hash": self.config_hash,
+            "git_commit": self.git_commit,
+        }
+
+    def _save_cache_atomic(self, cache_path: Path, payload: dict, num_samples: int) -> None:
+        cache_path.parent.mkdir(parents=True, exist_ok=True)
+        tmp_path = cache_path.with_name(f"{cache_path.name}.{os.getpid()}.tmp")
+        try:
+            torch.save(payload, tmp_path)
+            verified = _torch_load(tmp_path, "cpu")
+            samples = verified.get("samples")
+            if samples is None or int(samples.shape[1]) != int(num_samples):
+                raise RuntimeError(
+                    f"Cache verification failed for {tmp_path}: "
+                    f"expected {num_samples} samples, got {None if samples is None else samples.shape}"
+                )
+            os.replace(tmp_path, cache_path)
+        finally:
+            if tmp_path.exists():
+                try:
+                    tmp_path.unlink()
+                except OSError:
+                    pass
+
+    def _cache_path(self, batch_x: torch.Tensor, batch_y: torch.Tensor, num_samples: int, sample_chunk_size: int, split: str) -> Path:
+        metadata = self._cache_metadata(num_samples, sample_chunk_size, split)
+        digest = hashlib.sha256(json.dumps(metadata, sort_keys=True).encode("utf-8"))
+        digest.update(self._tensor_digest(batch_x, batch_y).encode("utf-8"))
+        key = digest.hexdigest()
+        return self._cache_root() / self.dataset_type / f"{split}_{key}.pt"
+
+    def _indexed_cache_path(self, split: str, num_samples: int, sample_chunk_size: int, batch_index: int) -> Path:
+        metadata = self._cache_metadata(num_samples, sample_chunk_size, split, batch_index=batch_index)
+        key = hashlib.sha256(json.dumps(metadata, sort_keys=True).encode("utf-8")).hexdigest()
+        return self._cache_root() / self.dataset_type / f"{split}_batch{batch_index:05d}_{key}.pt"
+
+    def _sample_diffusionts(
+        self,
+        batch_x: torch.Tensor,
+        batch_y: torch.Tensor,
+        num_samples: int,
+        split: str = None,
+        batch_index: int = None,
+        return_cpu: bool = False,
+    ) -> torch.Tensor:
+        """Use DiffusionTS conditional infill and return canonical [B, N, H, D] samples."""
+
+        self.model.eval()
+        chunk = int(self.sample_chunk_size or self.minisample)
+        if chunk <= 0:
+            raise ValueError("--sample_chunk_size must be positive")
+        chunk_sizes = [chunk] * (num_samples // chunk)
+        remainder = num_samples % chunk
+        if remainder:
+            chunk_sizes.append(remainder)
+
+        split = split or getattr(self, "_cache_split", "unknown")
+        if batch_index is None:
+            cache_path = self._cache_path(batch_x, batch_y, num_samples, chunk, split)
+        else:
+            cache_path = self._indexed_cache_path(split, num_samples, chunk, batch_index)
+        if cache_path.exists():
+            try:
+                cached = _torch_load(cache_path, "cpu")
+                cached_samples = cached.get("samples")
+                if cached_samples is None or int(cached_samples.shape[1]) != int(num_samples):
+                    raise RuntimeError(f"completed_samples mismatch: {None if cached_samples is None else cached_samples.shape}")
+                print(f"[CACHE HIT] split={split} samples={num_samples} chunk={chunk} path={cache_path}", flush=True)
+                if return_cpu:
+                    return cached_samples.to(dtype=torch.float16 if self.cache_dtype == "float16" else torch.float32)
+                return cached_samples.to(self.device, dtype=torch.float32, non_blocking=True)
+            except Exception as exc:
+                bad_path = cache_path.with_suffix(cache_path.suffix + f".corrupt.{os.getpid()}")
+                print(f"[CACHE CORRUPT] path={cache_path} reason={exc} quarantine={bad_path}", flush=True)
+                try:
+                    os.replace(cache_path, bad_path)
+                except OSError:
+                    pass
+
+        x = torch.concat([batch_x, batch_y], dim=1)
+        batch_size = x.shape[0]
+        target_mask = self.gt_mask.expand((batch_size, -1, -1))
+        model_kwargs = {"coef": 1e-1, "learning_rate": 5e-2}
+        samples = []
+
+        print(f"[CACHE MISS] split={split} samples={num_samples} chunk={chunk} path={cache_path}", flush=True)
+        with torch.enable_grad():
+            for current_chunk in chunk_sizes:
+                repeat_x = x.repeat(current_chunk, 1, 1)
+                repeat_mask = target_mask.repeat(current_chunk, 1, 1)
+                sample = self.model.fast_sample_infill(
+                    shape=repeat_x.shape,
+                    target=repeat_x * repeat_mask,
+                    partial_mask=repeat_mask,
+                    model_kwargs=model_kwargs,
+                    sampling_timesteps=self.sampling_timesteps,
+                )
+                sample = sample[:, -self.pred_len :, :].reshape(
+                    batch_size,
+                    current_chunk,
+                    self.pred_len,
+                    self.dataset.num_features,
+                )
+                samples.append(sample.detach().to("cpu", dtype=torch.float32))
+                del sample, repeat_x, repeat_mask
+                if torch.cuda.is_available():
+                    torch.cuda.empty_cache()
+
+        result = torch.concat(samples, dim=1).to(torch.float32)
+        cache_path.parent.mkdir(parents=True, exist_ok=True)
+        metadata = self._cache_metadata(num_samples, chunk, split, batch_index=batch_index)
+        save_samples = result.detach().cpu()
+        if self.cache_dtype == "float16":
+            save_samples = save_samples.to(torch.float16)
+        self._save_cache_atomic(cache_path, {"metadata": metadata, "samples": save_samples}, num_samples)
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+        if return_cpu:
+            return save_samples
+        return result.to(self.device, dtype=torch.float32, non_blocking=True)
+
+    def _load_cached_samples(self, path: Path) -> torch.Tensor:
+        cached = _torch_load(path, "cpu")
+        samples = cached.get("samples")
+        if samples is None:
+            raise RuntimeError(f"Missing samples in cache {path}")
+        return samples
+
+    def _prepare_cache_records(self, loader, limit_batches: int, prefix: str, num_samples: int, include_aug: bool):
+        records = []
+        for step, (batch_x, batch_y, _origin_x, _origin_y, _batch_x_mark, _batch_y_mark) in enumerate(loader, start=1):
+            if limit_batches > 0 and step > limit_batches:
+                break
+            batch_x_gpu = batch_x.to(self.device, non_blocking=True).float()
+            batch_y_gpu = batch_y.to(self.device, non_blocking=True).float()
+            target_cpu = self._target(batch_y_gpu).detach().cpu()
+            base_split = f"{prefix}_base"
+            base_cpu = self._sample_diffusionts(
+                batch_x_gpu,
+                batch_y_gpu,
+                num_samples,
+                split=base_split,
+                batch_index=step,
+                return_cpu=True,
+            )
+            base_path = self._indexed_cache_path(base_split, num_samples, int(self.sample_chunk_size or self.minisample), step)
+            record = {"batch_index": step, "target": target_cpu, "base": base_path, "num_samples": num_samples}
+            if include_aug:
+                aug_x = self._deterministic_aug_context(batch_x_gpu, batch_y_gpu, f"{prefix}_aug")
+                aug_split = f"{prefix}_aug"
+                self._sample_diffusionts(
+                    aug_x,
+                    batch_y_gpu,
+                    num_samples,
+                    split=aug_split,
+                    batch_index=step,
+                    return_cpu=True,
+                )
+                record["aug"] = self._indexed_cache_path(aug_split, num_samples, int(self.sample_chunk_size or self.minisample), step)
+                del aug_x
+            records.append(record)
+            del batch_x_gpu, batch_y_gpu, target_cpu, base_cpu
+            if torch.cuda.is_available():
+                torch.cuda.empty_cache()
+        return records
+
+    def _target(self, batch_y: torch.Tensor) -> torch.Tensor:
+        return batch_y[:, -self.pred_len :, :].to(self.device)
+
+    def _make_calibrator(self) -> SampleSPARCCalibrator:
+        return SampleSPARCCalibrator(
+            prediction_length=self.pred_len,
+            target_dim=self.dataset.num_features,
+            hidden_dim=self.sparc_hidden_dim,
+            mean_correction=self.mean_correction,
+            max_mean_delta=self.max_mean_delta,
+            max_log_scale_delta=self.max_log_scale_delta,
+            calibration_strength=self.calibration_strength,
+            nll_weight=self.sparc_nll_weight,
+            quantile_weight=self.sparc_quantile_weight,
+            pit_weight=self.sparc_pit_weight,
+            pit_temperature=self.sparc_pit_temperature,
+        ).to(self.device)
+
+    def _deterministic_aug_context(self, batch_x: torch.Tensor, batch_y: torch.Tensor, split: str) -> torch.Tensor:
+        digest = hashlib.sha256()
+        digest.update(str(getattr(self, "_active_seed", None)).encode("utf-8"))
+        digest.update(split.encode("utf-8"))
+        digest.update(self._tensor_digest(batch_x, batch_y).encode("utf-8"))
+        seed = int(digest.hexdigest()[:16], 16) % (2**31 - 1)
+        cpu_state = torch.random.get_rng_state()
+        cuda_state = torch.cuda.get_rng_state(self.device) if torch.cuda.is_available() and str(self.device).startswith("cuda") else None
+        try:
+            torch.manual_seed(seed)
+            if cuda_state is not None:
+                torch.cuda.manual_seed_all(seed)
+            return augment_context(
+                batch_x,
+                jitter_std=self.jitter_std,
+                scaling_std=self.scaling_std,
+                time_mask_ratio=self.time_mask_ratio,
+            )
+        finally:
+            torch.random.set_rng_state(cpu_state)
+            if cuda_state is not None:
+                torch.cuda.set_rng_state(cuda_state, self.device)
+
+    def _sparc_batch_loss(self, batch_x, batch_y, num_samples: int = None) -> torch.Tensor:
+        num_samples = int(num_samples or self.stats_num_samples)
+        target = self._target(batch_y)
+        with torch.no_grad():
+            self._cache_split = "sparc_train_base"
+            base_stats = self._sample_diffusionts(batch_x, batch_y, num_samples)
+            aug_x = self._deterministic_aug_context(batch_x, batch_y, "sparc_train_aug")
+            self._cache_split = "sparc_train_aug"
+            aug_stats = self._sample_diffusionts(aug_x, batch_y, num_samples)
+        return self.sparc_calibrator.loss(base_stats, aug_stats, target)
+
+    def _record_chunked_loss(self, record: dict, backward: bool = False) -> float:
+        base_cpu = self._load_cached_samples(record["base"])
+        aug_cpu = self._load_cached_samples(record["aug"])
+        target_cpu = record["target"]
+        batch_size, _num_samples, horizon, feature_dim = base_cpu.shape
+        micro = max(1, int(self.calibrator_micro_batch_size))
+        time_chunk = max(1, int(self.time_chunk_size))
+        feature_chunk = max(1, int(self.feature_chunk_size))
+        total_elements = float(batch_size * horizon * feature_dim)
+        total_loss = 0.0
+
+        for b0 in range(0, batch_size, micro):
+            b1 = min(batch_size, b0 + micro)
+            for t0 in range(0, horizon, time_chunk):
+                t1 = min(horizon, t0 + time_chunk)
+                for f0 in range(0, feature_dim, feature_chunk):
+                    f1 = min(feature_dim, f0 + feature_chunk)
+                    base = base_cpu[b0:b1, :, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    aug = aug_cpu[b0:b1, :, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    target = target_cpu[b0:b1, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    if not getattr(self.sparc_calibrator, "_diagnose_printed", False):
+                        self.sparc_calibrator.diagnose_next_forward()
+                    loss = self.sparc_calibrator.loss(base, aug, target, horizon_offset=t0)
+                    weight = float((b1 - b0) * (t1 - t0) * (f1 - f0)) / total_elements
+                    weighted = loss * weight
+                    if backward:
+                        weighted.backward()
+                    total_loss += float(weighted.detach().cpu())
+                    del base, aug, target, loss, weighted
+        return total_loss
+
+    def _calibrate_samples_chunked(
+        self,
+        output_cpu: torch.Tensor,
+        base_cpu: torch.Tensor,
+        aug_cpu: torch.Tensor,
+    ) -> torch.Tensor:
+        batch_size, _num_samples, horizon, feature_dim = output_cpu.shape
+        result = torch.empty_like(output_cpu, dtype=torch.float32, device="cpu")
+        micro = max(1, int(self.calibrator_micro_batch_size))
+        time_chunk = max(1, int(self.time_chunk_size))
+        feature_chunk = max(1, int(self.feature_chunk_size))
+        for b0 in range(0, batch_size, micro):
+            b1 = min(batch_size, b0 + micro)
+            for t0 in range(0, horizon, time_chunk):
+                t1 = min(horizon, t0 + time_chunk)
+                for f0 in range(0, feature_dim, feature_chunk):
+                    f1 = min(feature_dim, f0 + feature_chunk)
+                    output = output_cpu[b0:b1, :, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    base = base_cpu[b0:b1, :, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    aug = aug_cpu[b0:b1, :, t0:t1, f0:f1].to(self.device, dtype=torch.float32, non_blocking=True)
+                    calibrated = self.sparc_calibrator.calibrate_samples_with_stats(
+                        output,
+                        base,
+                        aug,
+                        horizon_offset=t0,
+                    )
+                    result[b0:b1, :, t0:t1, f0:f1] = calibrated.detach().cpu()
+                    del output, base, aug, calibrated
+        return result
+
+    def _validate_sparc(self) -> float:
+        self.sparc_calibrator.eval()
+        losses = []
+        with torch.no_grad():
+            for record in getattr(self, "_val_cache_records", []):
+                losses.append(self._record_chunked_loss(record, backward=False))
+        return float(np.mean(losses)) if losses else float("inf")
+
+    def _train_sparc_head(self, output_root: Path) -> Path:
+        self.sparc_calibrator = self._make_calibrator()
+        optimizer = torch.optim.Adam(self.sparc_calibrator.parameters(), lr=self.sparc_learning_rate)
+        best_path = output_root / "sparc_calibrator.pt"
+        best_loss = float("inf")
+        bad_epochs = 0
+
+        print("[CACHE PREP] split=sparc_train", flush=True)
+        self._train_cache_records = self._prepare_cache_records(
+            self.train_loader,
+            self.limit_train_batches,
+            "sparc_train",
+            self.pit_fit_num_samples,
+            include_aug=True,
+        )
+        print("[CACHE PREP] split=sparc_val", flush=True)
+        self._val_cache_records = self._prepare_cache_records(
+            self.val_loader,
+            self.limit_val_batches,
+            "sparc_val",
+            self.val_num_samples,
+            include_aug=True,
+        )
+
+        for epoch in range(1, self.sparc_epochs + 1):
+            self.sparc_calibrator.train()
+            train_losses = []
+            with tqdm(total=len(self._train_cache_records), desc=f"SPARC epoch {epoch}") as progress_bar:
+                for record in self._train_cache_records:
+                    optimizer.zero_grad()
+                    loss_value = self._record_chunked_loss(record, backward=True)
+                    torch.nn.utils.clip_grad_norm_(self.sparc_calibrator.parameters(), 1.0)
+                    optimizer.step()
+
+                    train_losses.append(loss_value)
+                    progress_bar.update(1)
+                    progress_bar.set_postfix(loss=train_losses[-1])
+
+            val_loss = self._validate_sparc()
+            train_loss = float(np.mean(train_losses)) if train_losses else float("nan")
+            improvement = best_loss - val_loss
+            print(
+                f"[SPARC] epoch={epoch} train_loss={train_loss:.6f} "
+                f"val_CRPS={val_loss:.6f} best_val_CRPS={best_loss:.6f} "
+                f"improvement={improvement:.6f} bad_epoch={bad_epochs}",
+                flush=True,
+            )
+            if improvement > self.sparc_min_delta:
+                best_loss = val_loss
+                bad_epochs = 0
+                torch.save(
+                    {
+                        "state_dict": self.sparc_calibrator.state_dict(),
+                        "best_val_CRPS": best_loss,
+                        "epoch": epoch,
+                        "early_stopping": {
+                            "monitor": "val_CRPS",
+                            "mode": "min",
+                            "patience": self.sparc_patience,
+                            "min_delta": self.sparc_min_delta,
+                            "bad_epoch": bad_epochs,
+                        },
+                    },
+                    best_path,
+                )
+            else:
+                bad_epochs += 1
+                if bad_epochs >= self.sparc_patience:
+                    print(f"[SPARC] early_stopped=true epoch={epoch} bad_epoch={bad_epochs}", flush=True)
+                    break
+
+        state = _torch_load(best_path, self.device)
+        self.sparc_calibrator.load_state_dict(state["state_dict"])
+        self.sparc_calibrator.eval()
+        return best_path
+
+    def _collect_sparc_pit(self) -> np.ndarray:
+        loader = self.train_loader if self.pit_warp_fit_split == "train" else self.val_loader
+        pit_values = []
+        total_points = 0
+        rng = np.random.default_rng(2027)
