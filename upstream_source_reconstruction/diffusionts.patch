+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import ast
+import hashlib
+import json
+import re
+import time
+from pathlib import Path
+
+
+def parse_metrics(text: str) -> dict:
+    found = {}
+    for line in text.splitlines():
+        payload = ""
+        if "test_results:" in line:
+            payload = line.split("test_results:", 1)[1].strip()
+        elif line.strip().startswith("{") and line.strip().endswith("}"):
+            payload = line.strip()
+        if not payload:
+            continue
+        try:
+            parsed = ast.literal_eval(payload)
+        except Exception:
+            continue
+        if isinstance(parsed, dict) and "crps" in parsed:
+            found = {k: float(v) for k, v in parsed.items() if isinstance(v, (int, float))}
+    return found
+
+
+def sha256_checkpoint(path: str) -> str:
+    if not path:
+        return ""
+    root = Path(path)
+    ckpt = root / "best_model.pth"
+    if not ckpt.exists():
+        ckpt = root / "model.pth"
+    if not ckpt.exists():
+        return ""
+    h = hashlib.sha256()
+    with ckpt.open("rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--label", required=True)
+    parser.add_argument("--dataset-type", required=True)
+    parser.add_argument("--stage", required=True, choices=["baseline", "sparc"])
+    parser.add_argument("--log", required=True)
+    parser.add_argument("--out-root", required=True)
+    parser.add_argument("--checkpoint", default="")
+    parser.add_argument("--auto-baseline", default="false")
+    parser.add_argument("--status", default="ok")
+    args = parser.parse_args()
+
+    out_root = Path(args.out_root)
+    text = Path(args.log).read_text(encoding="utf-8", errors="ignore") if Path(args.log).exists() else ""
+    metrics = parse_metrics(text)
+    oom = bool(re.search(r"OutOfMemory|CUDA out of memory|CUBLAS_STATUS_ALLOC_FAILED|GPU_HARD_LIMIT", text))
+    nan_inf = bool(re.search(r"\b(nan|inf)\b", text, flags=re.IGNORECASE))
+    cache_hits = text.count("[CACHE HIT]")
+    cache_misses = text.count("[CACHE MISS]")
+    peak_file = Path(args.log).with_suffix(".peak")
+    peak_memory = peak_file.read_text().strip() if peak_file.exists() else ""
+
+    doc = {
+        "dataset": args.label,
