+            batch_y =   torch.concat([batch_y, batch_y[0:1, :, :]], dim=0) if b%2  else batch_y 
+            batch_y_date_enc =   torch.concat([batch_y_date_enc, batch_y_date_enc[0:1, :, :]], dim=0) if b%2 else batch_y_date_enc 
