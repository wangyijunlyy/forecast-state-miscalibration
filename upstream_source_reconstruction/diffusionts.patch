+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+from pathlib import Path
+from typing import Dict, List
+
+import numpy as np
+import torch
+from tqdm import tqdm
+
+from src.experiments.TMDM import TMDMForecast
+from src.nn.tmdm_diffusion_utils import p_sample_loop
+from src.sparc_pit import SampleSPARCCalibrator, PITWarpCalibrator, augment_context
+from src.sparc_pit.pit_warp import compute_sample_pit, qice_from_pit
+
+
+def _torch_load(path: Path, device: str):
+    try:
+        return torch.load(path, map_location=device, weights_only=True)
+    except TypeError:
+        return torch.load(path, map_location=device)
+
+
+@dataclass
+class TMDMSPARCPITForecast(TMDMForecast):
+    """Post-hoc SPARC-PIT wrapper for a frozen TMDM checkpoint."""
+
+    model_type: str = "TMDM_SPARC_PIT"
+    checkpoint_dir: str = ""
+    output_dir: str = "./results/sparc_pit/TMDM_ETTh1_w168h1s192_seed1"
+    beta_end: float = 0.02
+    diffusion_steps: int = 1000
+    stats_num_samples: int = 100
+    eval_num_samples: int = 100
+    tmdm_minisample: int = 10
+    sparc_epochs: int = 5
+    sparc_patience: int = 2
+    sparc_learning_rate: float = 0.001
+    sparc_hidden_dim: int = 128
+    calibration_strength: float = 0.4
+    mean_correction: bool = False
+    max_mean_delta: float = 0.0
+    max_log_scale_delta: float = 0.4
+    sparc_nll_weight: float = 0.5
+    sparc_quantile_weight: float = 0.5
+    sparc_pit_weight: float = 40.0
+    sparc_pit_temperature: float = 0.01
+    pit_warp_fit_split: str = "train"
+    pit_warp_knots: int = 41
+    pit_warp_strength: float = 0.5
+    limit_train_batches: int = 100
+    limit_val_batches: int = 0
+    limit_pit_fit_batches: int = 100
+    max_pit_fit_points: int = 2_000_000
+    jitter_std: float = 0.01
+    scaling_std: float = 0.05
+    time_mask_ratio: float = 0.05
+
+    def _load_frozen_checkpoint(self) -> None:
+        if not self.checkpoint_dir:
+            raise ValueError("--checkpoint_dir is required for TMDM-SPARC-PIT")
+        root = Path(self.checkpoint_dir).expanduser()
+        paths = {
+            "model": root / "model.pth",
+            "cond_pred_model": root / "cond_pred_model.pth",
+        }
+        missing = [str(path) for path in paths.values() if not path.exists()]
+        if missing:
+            raise FileNotFoundError(f"Missing checkpoint file(s): {missing}")
+
+        self.model.load_state_dict(_torch_load(paths["model"], self.device))
+        self.cond_pred_model.load_state_dict(_torch_load(paths["cond_pred_model"], self.device))
+
+        for module in (self.model, self.cond_pred_model):
+            module.eval()
+            for parameter in module.parameters():
+                parameter.requires_grad = False
+
+    def _set_backbone_eval(self) -> None:
+        self.model.eval()
+        self.cond_pred_model.eval()
+
+    def _sample_tmdm(
+        self,
+        batch_x: torch.Tensor,
+        batch_x_mark: torch.Tensor,
+        batch_y_mark: torch.Tensor,
+        num_samples: int,
+    ) -> torch.Tensor:
+        """Use the original TMDM reverse-diffusion path and return [B, N, H, D]."""
+
+        self._set_backbone_eval()
+        batch_size = batch_x.shape[0]
+        f_dim = -1 if self.args.features == "MS" else 0
+        minisample = int(self.tmdm_minisample)
+        if minisample <= 0:
+            raise ValueError("--tmdm_minisample must be positive")
+        if num_samples % minisample != 0:
+            raise ValueError(f"num_samples={num_samples} must be divisible by minisample={minisample}")
+
+        batch_y_mark_input = torch.concat([batch_x_mark[:, -self.label_len :, :], batch_y_mark], dim=1)
+        dec_inp_pred = torch.zeros(
+            [batch_x.size(0), self.pred_len, self.dataset.num_features],
+            device=self.device,
+        )
+        dec_inp_label = batch_x[:, -self.label_len :, :].to(self.device)
+        dec_inp = torch.cat([dec_inp_label, dec_inp_pred], dim=1)
+
+        _point_pred, y_0_hat_batch, _kl_loss, _z_sample = self.cond_pred_model(
+            batch_x,
+            batch_x_mark,
+            dec_inp,
+            batch_y_mark_input,
+        )
+
+        preds = []
+        for _ in range(num_samples // minisample):
+            repeat_n = int(minisample)
+            y_0_hat_tile = y_0_hat_batch.repeat(repeat_n, 1, 1, 1)
+            y_0_hat_tile = y_0_hat_tile.transpose(0, 1).flatten(0, 1).to(self.device)
+            y_T_mean_tile = y_0_hat_tile
+
+            x_tile = batch_x.repeat(repeat_n, 1, 1, 1)
+            x_tile = x_tile.transpose(0, 1).flatten(0, 1).to(self.device)
+            x_mark_tile = batch_x_mark.repeat(repeat_n, 1, 1, 1)
+            x_mark_tile = x_mark_tile.transpose(0, 1).flatten(0, 1).to(self.device)
+
+            y_tile_seq = p_sample_loop(
+                self.model,
+                x_tile,
+                x_mark_tile,
+                y_0_hat_tile,
+                y_T_mean_tile,
+                self.model.num_timesteps,
+                self.model.alphas,
+                self.model.one_minus_alphas_bar_sqrt,
+            )
+            gen_y = y_tile_seq[self.model.num_timesteps].reshape(
+                batch_size,
+                minisample,
+                self.label_len + self.pred_len,
+                self.dataset.num_features,
+            )
+            preds.append(gen_y[:, :, -self.pred_len :, f_dim:].detach())
+
+        return torch.concat(preds, dim=1)
+
+    def _target(self, batch_y: torch.Tensor) -> torch.Tensor:
+        f_dim = -1 if self.args.features == "MS" else 0
+        return batch_y[:, -self.pred_len :, f_dim:].to(self.device)
+
+    def _make_calibrator(self) -> SampleSPARCCalibrator:
+        return SampleSPARCCalibrator(
+            prediction_length=self.pred_len,
+            target_dim=self.dataset.num_features,
+            hidden_dim=self.sparc_hidden_dim,
+            mean_correction=self.mean_correction,
+            max_mean_delta=self.max_mean_delta,
+            max_log_scale_delta=self.max_log_scale_delta,
+            calibration_strength=self.calibration_strength,
+            nll_weight=self.sparc_nll_weight,
+            quantile_weight=self.sparc_quantile_weight,
+            pit_weight=self.sparc_pit_weight,
+            pit_temperature=self.sparc_pit_temperature,
+        ).to(self.device)
+
+    def _sparc_batch_loss(self, batch_x, batch_y, batch_x_mark, batch_y_mark) -> torch.Tensor:
+        target = self._target(batch_y)
+        with torch.no_grad():
+            base_stats = self._sample_tmdm(batch_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+            aug_x = augment_context(
+                batch_x,
+                jitter_std=self.jitter_std,
+                scaling_std=self.scaling_std,
+                time_mask_ratio=self.time_mask_ratio,
+            )
+            aug_stats = self._sample_tmdm(aug_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+        return self.sparc_calibrator.loss(base_stats, aug_stats, target)
+
+    def _validate_sparc(self) -> float:
+        self.sparc_calibrator.eval()
+        losses = []
+        with torch.no_grad():
+            for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in enumerate(
+                self.val_loader,
+                start=1,
+            ):
+                if self.limit_val_batches > 0 and step > self.limit_val_batches:
+                    break
+                batch_x = batch_x.to(self.device).float()
+                batch_y = batch_y.to(self.device).float()
+                batch_x_mark = batch_x_mark.to(self.device).float()
+                batch_y_mark = batch_y_mark.to(self.device).float()
+                loss = self._sparc_batch_loss(batch_x, batch_y, batch_x_mark, batch_y_mark)
+                losses.append(float(loss.detach().cpu()))
+        return float(np.mean(losses)) if losses else float("inf")
+
+    def _train_sparc_head(self, output_root: Path) -> Path:
+        self.sparc_calibrator = self._make_calibrator()
+        optimizer = torch.optim.Adam(self.sparc_calibrator.parameters(), lr=self.sparc_learning_rate)
+        best_path = output_root / "sparc_calibrator.pt"
+        best_loss = float("inf")
+        bad_epochs = 0
+
+        for epoch in range(1, self.sparc_epochs + 1):
+            self.sparc_calibrator.train()
+            train_losses = []
+            with tqdm(total=len(self.train_loader.dataset), desc=f"SPARC epoch {epoch}") as progress_bar:
+                for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in enumerate(
+                    self.train_loader,
+                    start=1,
+                ):
+                    if self.limit_train_batches > 0 and step > self.limit_train_batches:
+                        break
+                    batch_x = batch_x.to(self.device).float()
+                    batch_y = batch_y.to(self.device).float()
+                    batch_x_mark = batch_x_mark.to(self.device).float()
+                    batch_y_mark = batch_y_mark.to(self.device).float()
+
+                    loss = self._sparc_batch_loss(batch_x, batch_y, batch_x_mark, batch_y_mark)
+                    optimizer.zero_grad()
+                    loss.backward()
+                    torch.nn.utils.clip_grad_norm_(self.sparc_calibrator.parameters(), 1.0)
+                    optimizer.step()
+
+                    train_losses.append(float(loss.detach().cpu()))
+                    progress_bar.update(batch_x.size(0))
+                    progress_bar.set_postfix(loss=train_losses[-1])
+
+            val_loss = self._validate_sparc()
+            train_loss = float(np.mean(train_losses)) if train_losses else float("nan")
+            print(f"[SPARC] epoch={epoch} train_loss={train_loss:.6f} val_loss={val_loss:.6f}", flush=True)
+            if val_loss < best_loss:
+                best_loss = val_loss
+                bad_epochs = 0
+                torch.save(
+                    {
+                        "state_dict": self.sparc_calibrator.state_dict(),
+                        "best_val_loss": best_loss,
+                    },
+                    best_path,
+                )
+            else:
+                bad_epochs += 1
+                if bad_epochs >= self.sparc_patience:
+                    print(f"[SPARC] early stopping at epoch={epoch}", flush=True)
+                    break
+
+        state = _torch_load(best_path, self.device)
+        self.sparc_calibrator.load_state_dict(state["state_dict"])
+        self.sparc_calibrator.eval()
+        return best_path
+
+    def _collect_sparc_pit(self) -> np.ndarray:
+        loader = self.train_loader if self.pit_warp_fit_split == "train" else self.val_loader
+        pit_values = []
+        total_points = 0
+        rng = np.random.default_rng(2027)
+        self.sparc_calibrator.eval()
+
+        with torch.no_grad():
+            for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in enumerate(
+                loader,
+                start=1,
+            ):
+                if self.limit_pit_fit_batches > 0 and step > self.limit_pit_fit_batches:
+                    break
+                if self.max_pit_fit_points > 0 and total_points >= self.max_pit_fit_points:
+                    break
+                batch_x = batch_x.to(self.device).float()
+                batch_y = batch_y.to(self.device).float()
+                batch_x_mark = batch_x_mark.to(self.device).float()
+                batch_y_mark = batch_y_mark.to(self.device).float()
+
+                output_samples = self._sample_tmdm(batch_x, batch_x_mark, batch_y_mark, self.eval_num_samples)
+                base_stats = self._sample_tmdm(batch_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+                aug_x = augment_context(
+                    batch_x,
+                    jitter_std=self.jitter_std,
+                    scaling_std=self.scaling_std,
+                    time_mask_ratio=self.time_mask_ratio,
+                )
+                aug_stats = self._sample_tmdm(aug_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+                samples = self.sparc_calibrator.calibrate_samples_with_stats(output_samples, base_stats, aug_stats)
+                pit = compute_sample_pit(
+                    samples.detach().cpu().numpy(),
+                    self._target(batch_y).detach().cpu().numpy(),
+                )
+                if self.max_pit_fit_points > 0 and total_points + pit.size > self.max_pit_fit_points:
+                    keep = self.max_pit_fit_points - total_points
+                    pit = pit[rng.choice(pit.size, size=keep, replace=False)]
+                pit_values.append(pit)
+                total_points += pit.size
+                if step % 10 == 0:
+                    print(f"[PIT] collected step={step} pit_points={total_points}", flush=True)
+
+        if not pit_values:
+            raise RuntimeError("No PIT values collected for PIT warp fitting")
+        return np.concatenate(pit_values, axis=0)
+
+    def _fit_pit_warp(self, output_root: Path) -> Path:
+        pit = self._collect_sparc_pit()
+        before = qice_from_pit(pit, n_bins=10)
+        self.pit_warp = PITWarpCalibrator.from_pit(
+            pit,
+            n_knots=self.pit_warp_knots,
+            strength=self.pit_warp_strength,
+        )
+        after = qice_from_pit(self.pit_warp.transform_pit(pit), n_bins=10)
+        path = output_root / "pit_warp.npz"
+        np.savez(
+            path,
+            pit_knots=self.pit_warp.pit_knots,
+            uniform_knots=self.pit_warp.uniform_knots,
+            strength=np.array([self.pit_warp.strength], dtype=np.float64),
+        )
+        print(f"[PIT] qice_before={before:.6f} qice_after={after:.6f}", flush=True)
+        return path
+
+    def _process_val_batch(self, batch_x, batch_y, batch_x_mark, batch_y_mark):
+        if not hasattr(self, "sparc_calibrator"):
+            raise RuntimeError("SPARC calibrator is not initialized. Call run() first.")
+        with torch.no_grad():
+            output_samples = self._sample_tmdm(batch_x, batch_x_mark, batch_y_mark, self.eval_num_samples)
+            base_stats = self._sample_tmdm(batch_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+            aug_x = augment_context(
+                batch_x,
+                jitter_std=self.jitter_std,
+                scaling_std=self.scaling_std,
+                time_mask_ratio=self.time_mask_ratio,
+            )
+            aug_stats = self._sample_tmdm(aug_x, batch_x_mark, batch_y_mark, self.stats_num_samples)
+            samples = self.sparc_calibrator.calibrate_samples_with_stats(output_samples, base_stats, aug_stats)
+            if hasattr(self, "pit_warp") and self.pit_warp is not None:
+                warped = self.pit_warp.warp_samples(samples.detach().cpu().numpy())
+                samples = torch.as_tensor(warped, device=self.device, dtype=output_samples.dtype)
+            return samples.permute(0, 2, 3, 1).contiguous(), self._target(batch_y)
+
+    def run(self, seed=1) -> Dict[str, float]:
+        torch.manual_seed(seed)
+        np.random.seed(seed)
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(seed)
+
+        self._setup_run(seed)
+        os.makedirs(self.run_save_dir, exist_ok=True)
+        output_root = Path(self.output_dir).expanduser()
+        output_root.mkdir(parents=True, exist_ok=True)
+
+        self._load_frozen_checkpoint()
+        self.model.diffusion_config.testing.n_z_samples = int(self.eval_num_samples)
+        self._set_backbone_eval()
+
+        print(f"[checkpoint] {self.checkpoint_dir}", flush=True)
+        sparc_path = self._train_sparc_head(output_root)
+        pit_path = self._fit_pit_warp(output_root)
+        print(f"[saved] sparc={sparc_path}", flush=True)
+        print(f"[saved] pit={pit_path}", flush=True)
+
+        result = self._test()
+        metrics_path = output_root / "sparc_pit_test_metrics.txt"
+        with metrics_path.open("w", encoding="utf-8") as f:
+            f.write(str(result) + "\n")
+        print(f"[DONE] metrics={metrics_path}", flush=True)
+        return result
+
+    def runs(self, seeds: List[int] = None):
+        seeds = seeds or [1]
+        return [self.run(seed=seed) for seed in seeds]
+
+
+if __name__ == "__main__":
+    import fire
+
+    fire.Fire(TMDMSPARCPITForecast)
