+baseline_checkpoint: "${ckpt}"
+baseline_checkpoint_sha256: "${ckpt_hash}"
+input_length: ${WINDOWS}
+prediction_length: ${PRED_LEN}
+learning_rate: ${LR}
+baseline_batch_size: ${BASELINE_BATCH_SIZE}
+diffusion_steps: ${TIMESTEPS}
+sampling_timesteps: ${SAMPLING_TIMESTEPS}
+beta_schedule: "linear"
+beta_start: 0.0001
+beta_end: 0.02
+pit_fit_num_samples: ${PIT_FIT_NUM_SAMPLES}
+val_num_samples: ${VAL_NUM_SAMPLES}
+final_test_num_samples: ${FINAL_TEST_NUM_SAMPLES}
+sample_chunk_size: ${chunk}
+pit_sample_batch_size: ${pit_batch}
+limit_train_batches: ${LIMIT_TRAIN_BATCHES}
+limit_pit_fit_batches: ${LIMIT_PIT_FIT_BATCHES}
+limit_val_batches: ${LIMIT_VAL_BATCHES}
+sparc_epochs: ${SPARC_EPOCHS}
+early_stopping:
+  monitor: "val_CRPS"
+  mode: "min"
+  patience: ${SPARC_PATIENCE}
+  min_delta: ${SPARC_MIN_DELTA}
+  restore_best_weights: true
+cache_diffusionts_predictions: true
+cache_sorted_samples: true
+cache_dtype: "float16"
+config_hash: "${CONFIG_HASH}"
+git_commit: "${GIT_COMMIT}"
+YAML
+}
+
+convert_metrics() {
+  local label="$1" seed="$2" out_dir="$3" status="$4" peak="$5" ckpt="$6" chunk="$7" pit_batch="$8"
+  python - "$label" "$seed" "$out_dir" "$status" "$peak" "$ckpt" "$chunk" "$pit_batch" "$EXT_ROOT" <<'PY'
+import ast, json, sys, time, hashlib
+from pathlib import Path
+label, seed, out_dir, status, peak, ckpt, chunk, pit_batch, ext = sys.argv[1:]
+out = Path(out_dir)
+metrics = {}
+p = out / "sparc_pit_test_metrics.txt"
+if p.exists():
+    try:
+        metrics = ast.literal_eval(p.read_text().strip())
+    except Exception as exc:
+        metrics = {"parse_error": str(exc), "raw": p.read_text(errors="ignore")[:2000]}
+ckpt_file = Path(ckpt) / "best_model.pth"
+if not ckpt_file.exists():
+    ckpt_file = Path(ckpt) / "model.pth"
+sha = hashlib.sha256(ckpt_file.read_bytes()).hexdigest() if ckpt_file.exists() else ""
+doc = {
+    "dataset": label,
+    "seed": int(seed),
+    "baseline_checkpoint": ckpt,
+    "checkpoint_hash": sha,
+    "sample_chunk_size": int(chunk),
+    "pit_sample_batch_size": int(pit_batch),
+    "status": status,
+    "peak_memory_mib": int(peak) if str(peak).isdigit() else None,
+    "metrics": metrics,
