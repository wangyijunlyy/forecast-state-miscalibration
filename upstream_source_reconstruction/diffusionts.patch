+#!/usr/bin/env python3
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import torch
+
+from src.experiments.DiffusionTS import DiffusionTSForecast
+from src.metrics import CRPS, QICE, ProbMAE, ProbMSE
+
+
+def main() -> None:
+    root = Path.cwd()
+    log_dir = root / "logs" / "smoke"
+    log_dir.mkdir(parents=True, exist_ok=True)
+    report = log_dir / "smoke_diffusionts_sparc_pit.json"
+
+    exp = DiffusionTSForecast(
+        dataset_type="Electricity",
+        data_path="./data",
+        device="cuda:0" if torch.cuda.is_available() else "cpu",
+        batch_size=2,
+        num_worker=0,
+        windows=168,
+        horizon=1,
+        pred_len=192,
+        epochs=1,
+        lr=0.001,
+        num_samples=4,
+        sample_chunk_size=2,
+        timesteps=20,
+        sampling_timesteps=20,
+        beta_schedule="linear",
+        beta_start=0.0001,
+        beta_end=0.02,
+        scale_betas=False,
+    )
+    exp._setup_run(999)
+    batch = next(iter(exp.train_loader))
+    batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark = batch
+    batch_x = batch_x.to(exp.device).float()
+    batch_y = batch_y.to(exp.device).float()
+    batch_x_mark = batch_x_mark.to(exp.device).float()
+    batch_y_mark = batch_y_mark.to(exp.device).float()
+
+    loss = exp._process_train_batch(batch_x, batch_y, batch_x_mark, batch_y_mark)
+    loss.backward()
+    exp.model_optim.zero_grad()
+    samples, target = exp._process_val_batch(batch_x, batch_y, batch_x_mark, batch_y_mark)
+
+    metrics = {
+        "crps": CRPS(),
+        "qice": QICE(),
+        "mse": ProbMSE(),
+        "mae": ProbMAE(),
+    }
+    samples_cpu = samples.contiguous().detach().cpu()
+    target_cpu = target.contiguous().detach().cpu()
+    for metric in metrics.values():
+        metric.update(samples_cpu, target_cpu)
+    metric_values = {name: float(metric.compute()) for name, metric in metrics.items()}
+
+    ckpt = log_dir / "smoke_checkpoint.pt"
+    torch.save(exp.model.state_dict(), ckpt)
+    exp.model.load_state_dict(torch.load(ckpt, map_location=exp.device))
+
+    payload = {
+        "SMOKE_ONLY": True,
+        "dataset": "Electricity",
+        "batch_x_shape": list(batch_x.shape),
+        "batch_y_shape": list(batch_y.shape),
+        "samples_shape": list(samples.shape),
+        "target_shape": list(target.shape),
+        "loss": float(loss.detach().cpu()),
+        "metrics": metric_values,
+        "checkpoint": str(ckpt),
+    }
+    report.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    print(json.dumps(payload, indent=2))
+
+
+if __name__ == "__main__":
+    main()
