+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+from pathlib import Path
+
+
+PAPER = {
+    "ETTh2": {"crps": None, "qice": None},
+    "ETTm1": {"crps": None, "qice": None},
+    "EXG": {"crps": None, "qice": None},
+    "Solar": {"crps": None, "qice": None},
+}
+
+
+def read_json(path: Path) -> dict:
+    if not path.exists():
+        return {}
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def metric(doc: dict, key: str):
+    return doc.get("metrics", {}).get(key)
+
+
+def trend(base: dict, sparc: dict) -> str:
+    b_crps, s_crps = metric(base, "crps"), metric(sparc, "crps")
+    b_qice, s_qice = metric(base, "qice"), metric(sparc, "qice")
+    b_mse, s_mse = metric(base, "mse"), metric(sparc, "mse")
+    b_mae, s_mae = metric(base, "mae"), metric(sparc, "mae")
+    if b_crps is None or s_crps is None or b_qice is None or s_qice is None:
+        return "insufficient"
+    crps_pct = (s_crps - b_crps) / b_crps * 100.0 if b_crps else 0.0
+    qice_pct = (s_qice - b_qice) / b_qice * 100.0 if b_qice else 0.0
+    mse_pct = (s_mse - b_mse) / b_mse * 100.0 if b_mse and s_mse is not None else 0.0
+    mae_pct = (s_mae - b_mae) / b_mae * 100.0 if b_mae and s_mae is not None else 0.0
+    if crps_pct < -2.0 or qice_pct < -2.0:
+        if mse_pct <= 10.0 and mae_pct <= 10.0:
+            return "improving"
+    if abs(crps_pct) <= 2.0 and abs(qice_pct) <= 2.0 and mse_pct <= 10.0 and mae_pct <= 10.0:
+        return "maintain"
+    return "degrade"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out-root", required=True)
+    args = parser.parse_args()
+    out_root = Path(args.out_root)
+    rows = []
+    for label in ("ETTh2", "ETTm1", "EXG", "Solar"):
+        base = read_json(out_root / "results" / label / "baseline_metrics_seed1.json")
+        sparc = read_json(out_root / "results" / label / "sparc_pit_metrics_seed1.json")
+        rows.append({
+            "dataset": label,
+            "baseline_status": base.get("status", "missing"),
+            "sparc_status": sparc.get("status", "missing"),
+            "auto_baseline_trained": base.get("auto_baseline_trained", False) or sparc.get("auto_baseline_trained", False),
+            "baseline_crps": metric(base, "crps"),
+            "sparc_crps": metric(sparc, "crps"),
+            "baseline_qice": metric(base, "qice"),
+            "sparc_qice": metric(sparc, "qice"),
+            "baseline_mse": metric(base, "mse"),
+            "sparc_mse": metric(sparc, "mse"),
+            "baseline_mae": metric(base, "mae"),
+            "sparc_mae": metric(sparc, "mae"),
+            "baseline_picp": metric(base, "picp"),
+            "sparc_picp": metric(sparc, "picp"),
+            "baseline_rmse": metric(base, "rmse"),
+            "sparc_rmse": metric(sparc, "rmse"),
+            "trend": trend(base, sparc),
+            "peak_memory_mib": sparc.get("peak_memory_mib") or base.get("peak_memory_mib"),
+            "checkpoint_hash": sparc.get("baseline_checkpoint_sha256") or base.get("baseline_checkpoint_sha256"),
+        })
+
+    csv_path = out_root / "results" / "seed1_four_dataset_sparc_pit_comparison.csv"
+    csv_path.parent.mkdir(parents=True, exist_ok=True)
+    with csv_path.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
+        writer.writeheader()
+        writer.writerows(rows)
+
+    report = out_root / "artifacts" / "seed1_four_dataset_sparc_pit_report.md"
+    report.parent.mkdir(parents=True, exist_ok=True)
+    lines = ["# Seed1 Four Dataset DiffusionTS SPARC-PIT Report", ""]
+    for row in rows:
+        lines.append(f"## {row['dataset']}")
+        lines.append(f"- baseline_status: {row['baseline_status']}; sparc_status: {row['sparc_status']}")
+        lines.append(f"- auto_baseline_trained: {row['auto_baseline_trained']}")
+        lines.append(f"- CRPS: baseline={row['baseline_crps']} sparc={row['sparc_crps']}")
+        lines.append(f"- QICE: baseline={row['baseline_qice']} sparc={row['sparc_qice']}")
+        lines.append(f"- MSE/MAE: baseline={row['baseline_mse']}/{row['baseline_mae']} sparc={row['sparc_mse']}/{row['sparc_mae']}")
+        lines.append(f"- PICP/RMSE: baseline={row['baseline_picp']}/{row['baseline_rmse']} sparc={row['sparc_picp']}/{row['sparc_rmse']}")
+        lines.append(f"- trend: {row['trend']}")
+        lines.append("")
+    lines.append(f"CSV: {csv_path}")
+    report.write_text("\n".join(lines), encoding="utf-8")
+    print(csv_path)
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
