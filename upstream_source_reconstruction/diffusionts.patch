+            for layer in self.c_layers:
+                x, _next_state = layer.step(x, state=state.pop(), **kwargs)
+                next_state.append(_next_state)
+            x = x + outputs.pop()
+            u_layers = self.u_layers
+
+        for block in u_layers:
