+def one_hot(indices, depth, dim):
+    indices = indices.unsqueeze(dim)
+    size = list(indices.size())
+    size[dim] = depth
+    y_onehot =    torch.zeros(size).cuda()
+    y_onehot.zero_()
+    y_onehot.scatter_(dim, indices, 1)
+
+    return y_onehot
