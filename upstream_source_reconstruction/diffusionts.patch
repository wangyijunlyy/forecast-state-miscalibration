+def normalize_weight_jit(log_weight_norm, weight):
+    n = torch.exp(log_weight_norm)
+    wn = torch.sqrt(torch.sum(weight * weight, [1, 2, 3]))   # norm(w)
+    weight = n * weight / (wn.reshape((-1, 1, 1, 1)) + 1e-5)
+    return weight
