+          echo "DONE label=${label} seed=${seed} chunk=${chunk} pit_batch=${pit_batch} peak_mib=${peak}" | tee -a "$log"
+          convert_metrics "$label" "$seed" "$EXT_ROOT/results/sparc_pit/DiffusionTS_${dataset}_w${WINDOWS}h${HORIZON}s${PRED_LEN}_seed${seed}_${RUN_ID}" "DONE" "$peak" "$ckpt" "$chunk" "$pit_batch" | tee -a "$log"
+          date -Is > "$donefile"
+          success=1
+          break 2
+        fi
