+        div_term = 1 / torch.pow(
+            10000.0, torch.arange(0, d_model, 2).to(self.device) / d_model
+        )
+        pe[:, :, 0::2] = torch.sin(position * div_term)
+        pe[:, :, 1::2] = torch.cos(position * div_term)
+        return pe
