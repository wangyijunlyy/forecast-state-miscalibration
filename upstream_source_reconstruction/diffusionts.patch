+                    if isinstance(layer, UpPool):
+                        # Before modeling layer in the block
+                        x = x + outputs.pop()
+                        outputs.append(x)
+                x = x + outputs.pop()
+
+        # feature projection
+        x = self.norm(x)
+        return x, next_state
