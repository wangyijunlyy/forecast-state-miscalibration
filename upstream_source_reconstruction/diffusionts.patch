+#!/usr/bin/env bash
+set -euo pipefail
+
+LABEL="${1:?label required}"
+DATASET="${2:?dataset_type required}"
+GPU="${3:?gpu required}"
+CKPT="${4:?checkpoint_dir required}"
+
+ROOT="${ROOT:-$HOME/SPARC/NsDiff_DiffusionTS_SPARC_PIT_20260716}"
+OUT_ROOT="${OUT_ROOT:-/export/wyj/NsDiff_DiffusionTS_SPARC_PIT_seed1_four}"
+SEED=1
+RUN_ID="seed1_four_sparc_resume_$(date +%Y%m%d_%H%M%S)"
+
+WINDOWS=168
+PRED_LEN=192
+HORIZON=1
+EPOCHS=10
+PATIENCE=10
+LR=0.001
+NUM_WORKERS=8
+TIMESTEPS=20
+SAMPLING_TIMESTEPS=20
+TRAIN_RATIO=0.7
+TEST_RATIO=0.2
+
+LIMIT_TRAIN_BATCHES=50
+LIMIT_PIT_FIT_BATCHES=50
+LIMIT_VAL_BATCHES=20
+SPARC_EPOCHS=5
+SPARC_PATIENCE=1
+SPARC_MIN_DELTA=0.0005
+PIT_FIT_NUM_SAMPLES=100
+VAL_NUM_SAMPLES=20
+FINAL_TEST_NUM_SAMPLES=100
+PIT_SAMPLE_BATCH_SIZE=2
+
+cd "$ROOT"
+export PYTHONPATH="$ROOT:${PYTHONPATH:-}"
+if [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
+  source "$HOME/miniconda3/etc/profile.d/conda.sh"
+  conda activate k2vae
+elif [[ -x "$HOME/miniconda3/envs/k2vae/bin/python" ]]; then
+  export PATH="$HOME/miniconda3/envs/k2vae/bin:$PATH"
+fi
+mkdir -p "$OUT_ROOT/logs" "$OUT_ROOT/results/$LABEL" "$OUT_ROOT/cache" "$OUT_ROOT/checkpoints" "$OUT_ROOT/status"
+
+checkpoint_file_for_dir() {
+  local dir="$1"
+  if [[ -s "$dir/best_model.pth" ]]; then
+    echo "$dir/best_model.pth"
+  elif [[ -s "$dir/run_checkpoint.pth" ]]; then
+    echo "$dir/run_checkpoint.pth"
+  else
+    return 1
+  fi
+}
+
+write_resolved_config() {
+  local batch="$1" chunk="$2"
+  cat > "$OUT_ROOT/results/$LABEL/sparc_resume_seed1_resolved_config.yaml" <<YAML
+dataset: $LABEL
+dataset_type: $DATASET
+seed: 1
+stage: sparc_pit_resume_only
+gpu: $GPU
+baseline_checkpoint: $CKPT
+batch_size: $batch
+sample_chunk_size: $chunk
+pit_sample_batch_size: $PIT_SAMPLE_BATCH_SIZE
+time_chunk_size: 48
+feature_chunk_size: 64
+calibrator_micro_batch_size: 1
+input_length: $WINDOWS
+prediction_length: $PRED_LEN
+diffusion_steps: $TIMESTEPS
+beta_schedule: linear
+beta_start: 0.0001
+beta_end: 0.02
+limit_train_batches: $LIMIT_TRAIN_BATCHES
+limit_pit_fit_batches: $LIMIT_PIT_FIT_BATCHES
+limit_val_batches: $LIMIT_VAL_BATCHES
+sparc_epochs: $SPARC_EPOCHS
+early_stopping_patience: $SPARC_PATIENCE
+min_delta: $SPARC_MIN_DELTA
+pit_fit_num_samples: $PIT_FIT_NUM_SAMPLES
+val_num_samples: $VAL_NUM_SAMPLES
+final_test_num_samples: $FINAL_TEST_NUM_SAMPLES
+cache_diffusionts_predictions: true
+cache_sorted_samples: false
+cache_dtype: float16
+YAML
+}
+
+metrics_to_json() {
+  local stage="$1" log="$2" status="$3"
+  python scripts/DiffusionTS/extract_seed1_four_metrics.py \
+    --label "$LABEL" \
+    --dataset-type "$DATASET" \
+    --stage "$stage" \
+    --log "$log" \
+    --out-root "$OUT_ROOT" \
+    --checkpoint "$CKPT" \
+    --auto-baseline true \
+    --status "$status" || true
+}
+
+run_sparc_attempt() {
+  local batch="$1" chunk="$2" log="$3"
+  local out_dir="$OUT_ROOT/results/$LABEL/sparc_pit_seed1"
+  mkdir -p "$out_dir"
+  write_resolved_config "$batch" "$chunk"
+  echo "START_SPARC_RESUME label=$LABEL dataset=$DATASET seed=1 gpu=$GPU batch=$batch chunk=$chunk checkpoint=$CKPT" | tee -a "$log"
+  CUDA_VISIBLE_DEVICES="$GPU" PYTHONUNBUFFERED=1 python -u ./src/experiments/DiffusionTS_SPARC_PIT.py \
+    --dataset_type="$DATASET" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --horizon="$HORIZON" \
+    --pred_len="$PRED_LEN" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --lr="$LR" \
+    --num_worker="$NUM_WORKERS" \
+    --num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --sample_chunk_size="$chunk" \
+    --minisample="$chunk" \
+    --pit_sample_batch_size="$PIT_SAMPLE_BATCH_SIZE" \
+    --time_chunk_size=48 \
+    --feature_chunk_size=64 \
+    --calibrator_micro_batch_size=1 \
+    --timesteps="$TIMESTEPS" \
+    --sampling_timesteps="$SAMPLING_TIMESTEPS" \
+    --beta_schedule="linear" \
+    --beta_start=0.0001 \
+    --beta_end=0.02 \
+    --scale_betas=False \
+    --train_ratio="$TRAIN_RATIO" \
+    --test_ratio="$TEST_RATIO" \
+    --checkpoint_dir="$CKPT" \
+    --output_dir="$out_dir" \
+    --cache_dir="$OUT_ROOT/cache" \
+    --eval_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --stats_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --pit_fit_num_samples="$PIT_FIT_NUM_SAMPLES" \
+    --val_num_samples="$VAL_NUM_SAMPLES" \
+    --final_test_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --sparc_epochs="$SPARC_EPOCHS" \
+    --sparc_patience="$SPARC_PATIENCE" \
+    --sparc_min_delta="$SPARC_MIN_DELTA" \
+    --limit_train_batches="$LIMIT_TRAIN_BATCHES" \
+    --limit_pit_fit_batches="$LIMIT_PIT_FIT_BATCHES" \
+    --limit_val_batches="$LIMIT_VAL_BATCHES" \
+    --cache_dtype="float16" \
+    --cache_sorted_samples=False \
+    --config_hash="$RUN_ID-$LABEL-seed1" \
+    --git_commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" \
+    run --seed=1 >> "$log" 2>&1
+}
+
+main() {
+  local ckpt_file
+  ckpt_file="$(checkpoint_file_for_dir "$CKPT")"
+  sha256sum "$ckpt_file" > "$OUT_ROOT/results/$LABEL/seed1_checkpoint.sha256"
+  echo "$CKPT" > "$OUT_ROOT/status/${LABEL}_seed1_baseline_checkpoint.txt"
+  metrics_to_json baseline "$CKPT/output.log" ok
+
+  local log="$OUT_ROOT/logs/${LABEL}_sparc_resume_seed1.log"
+  : > "$log"
+  echo "$$" > "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.pid"
+  echo "$RUN_ID" > "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.lock"
+
+  local attempts=("32 4" "16 4" "8 4" "8 2" "8 1")
+  for attempt in "${attempts[@]}"; do
+    local batch="${attempt%% *}"
+    local chunk="${attempt##* }"
+    set +e
+    run_sparc_attempt "$batch" "$chunk" "$log"
+    local rc=$?
+    set -e
+    if [[ "$rc" -eq 0 ]]; then
+      metrics_to_json sparc_pit "$log" ok
+      date -Is > "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.DONE"
+      rm -f "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.lock"
+      echo "DONE_SPARC_RESUME label=$LABEL batch=$batch chunk=$chunk"
+      return 0
+    fi
+    if grep -E "OutOfMemory|CUDA out of memory|CUBLAS_STATUS_ALLOC_FAILED" "$log" >/dev/null 2>&1; then
+      echo "OOM_FALLBACK_SPARC_RESUME label=$LABEL batch=$batch chunk=$chunk rc=$rc" | tee -a "$log"
+      continue
+    fi
+    echo "FAILED_SPARC_RESUME_NON_OOM label=$LABEL batch=$batch chunk=$chunk rc=$rc" | tee -a "$log"
+    metrics_to_json sparc_pit "$log" failed
+    date -Is > "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.FAILED"
+    rm -f "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.lock"
+    return "$rc"
+  done
+
+  metrics_to_json sparc_pit "$log" oom_failed
+  date -Is > "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.FAILED"
+  rm -f "$OUT_ROOT/status/${LABEL}_sparc_resume_seed1.lock"
+  return 1
+}
+
+main
