+            path,
+            pit_knots=self.pit_warp.pit_knots,
+            uniform_knots=self.pit_warp.uniform_knots,
+            strength=np.array([self.pit_warp.strength], dtype=np.float64),
+            qice_before=np.array([before], dtype=np.float64),
+            qice_after=np.array([after], dtype=np.float64),
+        )
