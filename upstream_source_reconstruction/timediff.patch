+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+from typing import Dict, List
+
+import numpy as np
+import torch
+from tqdm import tqdm
+
+from src.experiments.TimeDiff import TimeDiffForecast
+from src.sparc_pit import SampleSPARCCalibrator, PITWarpCalibrator, augment_context
+from src.sparc_pit.pit_warp import compute_sample_pit, qice_from_pit
+
+
+def _torch_load(path: Path, device: str):
+    try:
+        return torch.load(path, map_location=device, weights_only=True)
+    except TypeError:
+        return torch.load(path, map_location=device)
+
+
+@dataclass
+class TimeDiffSPARCPITForecast(TimeDiffForecast):
+    model_type: str = "TimeDiff_SPARC_PIT"
+
+    checkpoint_dir: str = ""
+    output_dir: str = "./results/sparc_pit"
+    stats_num_samples: int = 100
+    eval_num_samples: int = 100
+    sample_chunk_size: int = 20
+
+    sparc_epochs: int = 5
+    sparc_patience: int = 1
+    sparc_min_delta: float = 0.0005
+    check_val_every_n_epoch: int = 1
+    sparc_learning_rate: float = 0.001
+    sparc_hidden_dim: int = 128
+
+    calibration_strength: float = 0.4
+    mean_correction: bool = False
+    max_mean_delta: float = 0.0
+    max_log_scale_delta: float = 0.4
+    sparc_nll_weight: float = 0.5
+    sparc_quantile_weight: float = 0.5
+    sparc_pit_weight: float = 40.0
+    sparc_pit_temperature: float = 0.01
+
+    pit_warp_fit_split: str = "train"
+    pit_warp_knots: int = 41
+    pit_warp_strength: float = 1.0
+    max_pit_fit_points: int = 2_000_000
+
+    limit_train_batches: int = 100
+    limit_pit_fit_batches: int = 100
+    limit_val_batches: int = 20
+    pit_fit_num_samples: int = 100
+    pit_sample_batch_size: int = 20
+    val_num_samples: int = 20
+    val_sample_batch_size: int = 20
+    val_fixed_seed: int = 2026
+    final_test_num_samples: int = 100
+    cache_timediff_predictions: bool = True
+    cache_sorted_samples: bool = True
+    cache_dtype: str = "float16"
+    pin_memory: bool = True
+    persistent_workers: bool = True
+    prefetch_factor: int = 4
+    resume: str = "auto"
+    resume_from: str = ""
+    force_restart: bool = False
+    reuse_cache: bool = True
+    rebuild_cache: bool = False
+
+    jitter_std: float = 0.01
+    scaling_std: float = 0.05
+    time_mask_ratio: float = 0.05
+
+    @staticmethod
+    def _resolve_model_path(root: Path) -> Path:
+        for filename in ("best_model.pth", "model.pth"):
+            path = root / filename
+            if path.exists():
+                return path
+        raise FileNotFoundError(f"Missing model checkpoint under {root}")
+
+    def _dataset_label(self) -> str:
+        return {
+            "Electricity": "ECL",
+            "ExchangeRate": "EXG",
+            "SolarEnergy": "Solar",
+        }.get(self.dataset_type, self.dataset_type)
+
+    def _checkpoint_root(self) -> Path:
+        return Path("checkpoints") / f"timeDiff_sparc_{self._dataset_label()}"
+
+    def _default_last_checkpoint(self) -> Path:
+        return self._checkpoint_root() / "last.pt"
+
+    def _timediff_checkpoint_path(self) -> str:
+        return str(self._resolve_model_path(Path(self.checkpoint_dir).expanduser()))
+
+    def _file_hash(self, path: Path) -> str:
+        digest = hashlib.sha1()
+        with path.open("rb") as f:
+            for chunk in iter(lambda: f.read(1024 * 1024), b""):
+                digest.update(chunk)
+        return digest.hexdigest()
+
+    def _timediff_checkpoint_hash(self) -> str:
+        return self._file_hash(Path(self._timediff_checkpoint_path()))
+
+    def _compat_signature(self) -> Dict[str, object]:
+        return {
+            "version": "timediff_sparc_pit_resume_v1",
+            "prediction_length": self.pred_len,
+            "feature_dimension": self.dataset.num_features,
+            "sparc_hidden_dim": self.sparc_hidden_dim,
+            "calibration_strength": self.calibration_strength,
+            "mean_correction": self.mean_correction,
+            "max_mean_delta": self.max_mean_delta,
+            "max_log_scale_delta": self.max_log_scale_delta,
+            "sparc_nll_weight": self.sparc_nll_weight,
+            "sparc_quantile_weight": self.sparc_quantile_weight,
+            "sparc_pit_weight": self.sparc_pit_weight,
+            "sparc_pit_temperature": self.sparc_pit_temperature,
+            "jitter_std": self.jitter_std,
+            "scaling_std": self.scaling_std,
+            "time_mask_ratio": self.time_mask_ratio,
+            "stats_num_samples": self.stats_num_samples,
+            "pit_fit_num_samples": self.pit_fit_num_samples,
+            "loss_inputs": "base_aug_target_samples",
+        }
+
+    def _load_frozen_checkpoint(self) -> None:
+        if not self.checkpoint_dir:
+            raise ValueError("--checkpoint_dir is required")
+        root = Path(self.checkpoint_dir).expanduser()
+        self.model.load_state_dict(_torch_load(self._resolve_model_path(root), self.device))
+        self.model.eval()
+        for parameter in self.model.parameters():
+            parameter.requires_grad = False
+
+    def _apply_loader_runtime_options(self) -> None:
+        for loader in (getattr(self, "train_loader", None), getattr(self, "val_loader", None), getattr(self, "test_loader", None)):
+            if loader is None:
+                continue
+            for name, value in (
+                ("pin_memory", self.pin_memory),
+                ("persistent_workers", self.persistent_workers and self.num_worker > 0),
+                ("prefetch_factor", self.prefetch_factor if self.num_worker > 0 else None),
+            ):
+                try:
+                    setattr(loader, name, value)
+                except Exception:
+                    pass
+
+    @staticmethod
+    def _as_bool(value) -> bool:
+        if isinstance(value, bool):
+            return value
+        if isinstance(value, str):
+            return value.strip().lower() in {"1", "true", "yes", "y", "on"}
+        return bool(value)
+
+    def _normalize_runtime_flags(self) -> None:
+        self.cache_timediff_predictions = self._as_bool(self.cache_timediff_predictions)
+        self.cache_sorted_samples = self._as_bool(self.cache_sorted_samples)
+        self.pin_memory = self._as_bool(self.pin_memory)
+        self.persistent_workers = self._as_bool(self.persistent_workers)
+        self.force_restart = self._as_bool(self.force_restart)
+        self.reuse_cache = self._as_bool(self.reuse_cache)
+        self.rebuild_cache = self._as_bool(self.rebuild_cache)
+        self._cache_hits = 0
+        self._cache_misses = 0
+
+    def _stable_cache_prefix(self, split: str, step: int, suffix: str = "") -> str:
+        base = f"{split}_step{int(step)}"
+        return f"{base}_{suffix}" if suffix else base
+
+    def _seeded_augment_context(self, batch_x: torch.Tensor, cache_prefix: str = None) -> torch.Tensor:
+        if not cache_prefix:
+            return augment_context(
+                batch_x,
+                jitter_std=self.jitter_std,
+                scaling_std=self.scaling_std,
+                time_mask_ratio=self.time_mask_ratio,
+            )
+        previous_state = torch.random.get_rng_state()
+        if torch.cuda.is_available():
+            previous_cuda_state = torch.cuda.get_rng_state_all()
+        torch.manual_seed(self._seed_for_cache_key(f"{cache_prefix}_augment"))
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(self._seed_for_cache_key(f"{cache_prefix}_augment"))
+        augmented = augment_context(
+            batch_x,
+            jitter_std=self.jitter_std,
+            scaling_std=self.scaling_std,
+            time_mask_ratio=self.time_mask_ratio,
+        )
+        torch.random.set_rng_state(previous_state)
+        if torch.cuda.is_available():
+            torch.cuda.set_rng_state_all(previous_cuda_state)
+        return augmented
+
+    def _gpu_status(self) -> Dict[str, object]:
+        status: Dict[str, object] = {
+            "gpu_id": os.environ.get("CUDA_VISIBLE_DEVICES", str(self.device)),
+            "memory_allocated_MiB": None,
+            "memory_reserved_MiB": None,
+            "gpu_utilization_pct": None,
+        }
+        if torch.cuda.is_available():
+            status["memory_allocated_MiB"] = round(torch.cuda.memory_allocated() / 1024 / 1024, 2)
+            status["memory_reserved_MiB"] = round(torch.cuda.memory_reserved() / 1024 / 1024, 2)
+        try:
+            result = subprocess.run(
+                [
+                    "nvidia-smi",
+                    "--query-gpu=utilization.gpu",
+                    "--format=csv,noheader,nounits",
+                    "--id",
+                    str(status["gpu_id"]).split(",")[0],
+                ],
+                check=False,
+                capture_output=True,
+                text=True,
+                timeout=5,
+            )
+            if result.returncode == 0 and result.stdout.strip():
+                status["gpu_utilization_pct"] = int(result.stdout.strip().splitlines()[0].strip())
+        except Exception:
+            pass
+        return status
+
+    def _log_gpu_status(self, prefix: str) -> None:
+        status = self._gpu_status()
+        print(
+            f"[GPU] {prefix} gpu_id={status['gpu_id']} "
+            f"memory_allocated_MiB={status['memory_allocated_MiB']} "
+            f"memory_reserved_MiB={status['memory_reserved_MiB']} "
+            f"gpu_utilization_pct={status['gpu_utilization_pct']}",
+            flush=True,
+        )
+
+    def _count_cache_hit(self) -> None:
+        self._cache_hits = getattr(self, "_cache_hits", 0) + 1
+
+    def _count_cache_miss(self) -> None:
+        self._cache_misses = getattr(self, "_cache_misses", 0) + 1
+
+    def _target(self, batch_y: torch.Tensor) -> torch.Tensor:
+        return batch_y[:, -self.pred_len :, :].to(self.device).float()
+
+    def _sample_timediff_uncached(
+        self,
+        batch_x: torch.Tensor,
+        batch_y: torch.Tensor,
+        batch_x_mark: torch.Tensor,
+        batch_y_mark: torch.Tensor,
+        num_samples: int,
+        sample_batch_size: int = None,
+    ) -> torch.Tensor:
+        pieces = []
+        remaining = int(num_samples)
+        chunk_size = max(1, int(sample_batch_size or self.sample_chunk_size))
+        self.model.eval()
+        while remaining > 0:
+            current = min(chunk_size, remaining)
+            outs, _x, _y, _unused_1, _unused_2 = self.model(
+                batch_x,
+                batch_x_mark,
+                batch_y,
+                batch_y_mark,
+                None,
+                None,
+                None,
+                current,
+            )
+            if outs.ndim != 4:
+                raise ValueError(f"Expected TimeDiff output [B, N, H, C], got {tuple(outs.shape)}")
+            pieces.append(outs.detach())
+            remaining -= current
+        samples = torch.cat(pieces, dim=1)
+        expected_tail = (self.pred_len, self.dataset.num_features)
+        if tuple(samples.shape[2:]) != expected_tail:
+            raise ValueError(f"Expected sample tail {expected_tail}, got {tuple(samples.shape[2:])}")
+        return samples
+
+    def _cache_file_for(self, cache_key: str, num_samples: int) -> Path:
+        safe_key = hashlib.sha1(cache_key.encode("utf-8")).hexdigest()
+        return self._prediction_cache_root / f"{safe_key}_n{num_samples}.pt"
+
+    def _cache_data_split(self, cache_key: str) -> str:
+        if cache_key.startswith("train_"):
+            return "train"
+        if cache_key.startswith("val_"):
+            return "val"
+        if cache_key.startswith("pit_"):
+            return self.pit_warp_fit_split
+        if cache_key.startswith("test_"):
+            return "test"
+        return "unknown"
+
+    def _cache_metadata(self, cache_key: str, num_samples: int) -> Dict[str, object]:
+        return {
+            "dataset": self._dataset_label(),
+            "data_split": self._cache_data_split(cache_key),
+            "timediff_checkpoint_path": self._timediff_checkpoint_path(),
+            "timediff_checkpoint_hash": self._timediff_checkpoint_hash(),
+            "seed": self.val_fixed_seed if cache_key.startswith("val_") else None,
+            "pit_fit_num_samples": self.pit_fit_num_samples,
+            "limit_pit_fit_batches": self.limit_pit_fit_batches,
+            "prediction_length": self.pred_len,
+            "feature_dimension": self.dataset.num_features,
+            "cache_dtype": self.cache_dtype,
+            "num_samples": int(num_samples),
+        }
+
+    def _cache_matches(self, cached: object, expected: Dict[str, object]) -> tuple[bool, str]:
+        if not isinstance(cached, dict) or "metadata" not in cached or "samples" not in cached:
+            return False, "legacy cache without metadata"
+        metadata = cached["metadata"]
+        for key, value in expected.items():
+            if metadata.get(key) != value:
+                return False, f"metadata mismatch {key}: cached={metadata.get(key)} expected={value}"
+        return True, ""
+
+    def _seed_for_cache_key(self, cache_key: str) -> int:
+        key_hash = int(hashlib.sha1(cache_key.encode("utf-8")).hexdigest()[:8], 16)
+        return int(self.val_fixed_seed + key_hash) % (2**31 - 1)
+
+    def _to_cache_dtype(self, tensor: torch.Tensor) -> torch.Tensor:
+        if self.cache_dtype == "float16":
+            return tensor.detach().cpu().to(torch.float16)
+        if self.cache_dtype == "bfloat16":
+            return tensor.detach().cpu().to(torch.bfloat16)
+        return tensor.detach().cpu().float()
+
+    def _sample_timediff_cached(
+        self,
+        cache_key: str,
+        batch_x: torch.Tensor,
+        batch_y: torch.Tensor,
+        batch_x_mark: torch.Tensor,
+        batch_y_mark: torch.Tensor,
+        num_samples: int,
+        sample_batch_size: int = None,
+    ) -> torch.Tensor:
+        if not self.cache_timediff_predictions:
+            return self._sample_timediff_uncached(batch_x, batch_y, batch_x_mark, batch_y_mark, num_samples, sample_batch_size)
+        path = self._cache_file_for(cache_key, num_samples)
+        expected_metadata = self._cache_metadata(cache_key, num_samples)
+        if self.reuse_cache and not self.rebuild_cache and path.exists():
+            cached = _torch_load(path, "cpu")
+            matches, reason = self._cache_matches(cached, expected_metadata)
+            if matches:
+                self._count_cache_hit()
+                print(f"[CACHE HIT] dataset={self._dataset_label()}, cache={path}", flush=True)
+                return cached["samples"].to(self.device).float()
+            self._count_cache_miss()
+            print(f"[CACHE MISS] dataset={self._dataset_label()}, reason={reason}, cache={path}", flush=True)
+        elif path.exists() and self.rebuild_cache:
+            self._count_cache_miss()
+            print(f"[CACHE MISS] dataset={self._dataset_label()}, reason=rebuild_cache requested, cache={path}", flush=True)
+        else:
+            self._count_cache_miss()
+            print(f"[CACHE MISS] dataset={self._dataset_label()}, reason=missing cache, cache={path}", flush=True)
+        previous_state = torch.random.get_rng_state()
+        if torch.cuda.is_available():
+            previous_cuda_state = torch.cuda.get_rng_state_all()
+        torch.manual_seed(self._seed_for_cache_key(cache_key))
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(self._seed_for_cache_key(cache_key))
+        samples = self._sample_timediff_uncached(batch_x, batch_y, batch_x_mark, batch_y_mark, num_samples, sample_batch_size)
+        torch.random.set_rng_state(previous_state)
+        if torch.cuda.is_available():
+            torch.cuda.set_rng_state_all(previous_cuda_state)
+        stored = samples
+        if self.cache_sorted_samples:
+            stored = torch.sort(stored, dim=1).values
+        path.parent.mkdir(parents=True, exist_ok=True)
+        torch.save({"metadata": expected_metadata, "samples": self._to_cache_dtype(stored)}, path)
+        print(f"[cache] write key={cache_key} samples={num_samples} dtype={self.cache_dtype}", flush=True)
+        return samples
+
+    def _sample_timediff(
+        self,
+        batch_x: torch.Tensor,
+        batch_y: torch.Tensor,
+        batch_x_mark: torch.Tensor,
+        batch_y_mark: torch.Tensor,
+        num_samples: int,
+        sample_batch_size: int = None,
+        cache_key: str = None,
+    ) -> torch.Tensor:
+        if cache_key:
+            return self._sample_timediff_cached(
+                cache_key,
+                batch_x,
+                batch_y,
+                batch_x_mark,
+                batch_y_mark,
+                num_samples,
+                sample_batch_size,
+            )
+        return self._sample_timediff_uncached(batch_x, batch_y, batch_x_mark, batch_y_mark, num_samples, sample_batch_size)
+
+    def _make_calibrator(self) -> SampleSPARCCalibrator:
+        return SampleSPARCCalibrator(
+            prediction_length=self.pred_len,
+            target_dim=self.dataset.num_features,
+            hidden_dim=self.sparc_hidden_dim,
+            mean_correction=self.mean_correction,
+            max_mean_delta=self.max_mean_delta,
+            max_log_scale_delta=self.max_log_scale_delta,
+            calibration_strength=self.calibration_strength,
+            nll_weight=self.sparc_nll_weight,
+            quantile_weight=self.sparc_quantile_weight,
+            pit_weight=self.sparc_pit_weight,
+            pit_temperature=self.sparc_pit_temperature,
+        ).to(self.device)
+
+    def _sparc_batch_loss(
+        self,
+        batch_x,
+        batch_y,
+        batch_x_mark,
+        batch_y_mark,
+        cache_prefix: str = None,
+        num_samples: int = None,
+        sample_batch_size: int = None,
+    ) -> torch.Tensor:
+        target = self._target(batch_y)
+        samples = int(num_samples or self.stats_num_samples)
+        with torch.no_grad():
+            base_stats = self._sample_timediff(
+                batch_x,
+                batch_y,
+                batch_x_mark,
+                batch_y_mark,
+                samples,
+                sample_batch_size,
+                f"{cache_prefix}_base" if cache_prefix else None,
+            )
+            aug_x = self._seeded_augment_context(batch_x, cache_prefix)
+            aug_stats = self._sample_timediff(
+                aug_x,
+                batch_y,
+                batch_x_mark,
+                batch_y_mark,
+                samples,
+                sample_batch_size,
+                f"{cache_prefix}_aug" if cache_prefix else None,
+            )
+        return self.sparc_calibrator.loss(base_stats, aug_stats, target)
+
+    def _iter_limited_loader(self, loader, limit: int):
+        for step, batch in enumerate(loader, start=1):
+            if limit > 0 and step > limit:
+                break
+            yield step, batch
+
+    def _validate_sparc(self) -> tuple[float, Dict[str, float]]:
+        self.sparc_calibrator.eval()
+        losses = []
+        self.metrics.reset()
+        torch.manual_seed(self.val_fixed_seed)
+        np.random.seed(self.val_fixed_seed)
+        with torch.no_grad():
+            for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in self._iter_limited_loader(
+                self.val_loader,
+                self.limit_val_batches,
+            ):
+                batch_x = batch_x.to(self.device).float()
+                batch_y = batch_y.to(self.device).float()
+                batch_x_mark = batch_x_mark.to(self.device).float()
+                batch_y_mark = batch_y_mark.to(self.device).float()
+                loss = self._sparc_batch_loss(
+                    batch_x,
+                    batch_y,
+                    batch_x_mark,
+                    batch_y_mark,
+                    cache_prefix=f"val_seed{self.val_fixed_seed}_step{step}",
+                    num_samples=self.val_num_samples,
+                    sample_batch_size=self.val_sample_batch_size,
+                )
+                losses.append(float(loss.detach().cpu()))
+                samples = self._process_eval_batch(
+                    batch_x,
+                    batch_y,
+                    batch_x_mark,
+                    batch_y_mark,
+                    step=step,
+                    phase="val",
+                )[0]
+                target = self._target(batch_y)
+                self.metrics.update(samples.contiguous().cpu().detach(), target.contiguous().cpu().detach())
+        metrics = {name: float(metric.compute()) for name, metric in self.metrics.items()} if losses else {}
+        return (float(np.mean(losses)) if losses else float("inf")), metrics
+
+    def _train_sparc_head(self, output_root: Path) -> Path:
+        self.sparc_calibrator = self._make_calibrator()
+        optimizer = torch.optim.Adam(self.sparc_calibrator.parameters(), lr=self.sparc_learning_rate)
+        scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda=lambda _epoch: 1.0)
+        best_path = output_root / "sparc_calibrator.pt"
+        last_path = self._default_last_checkpoint()
+        last_path.parent.mkdir(parents=True, exist_ok=True)
+        best_loss = float("inf")
+        bad_epochs = 0
+        start_epoch = 0
+
+        resume_state = self._load_resume_checkpoint(optimizer, scheduler)
+        if resume_state is not None:
+            start_epoch = int(resume_state["epoch"]) + 1
+            best_loss = float(resume_state["best_val_loss"])
+            bad_epochs = int(resume_state["bad_epochs"])
+        if start_epoch >= self.sparc_epochs:
+            print(
+                f"[RESUME] dataset={self._dataset_label()}, checkpoint={resume_state['checkpoint']}, "
+                f"start_epoch={start_epoch} already_complete=true",
+                flush=True,
+            )
+            if best_path.exists():
+                state = _torch_load(best_path, self.device)
+                self.sparc_calibrator.load_state_dict(state["state_dict"])
+            self.sparc_calibrator.eval()
+            return best_path
+
+        for epoch in range(start_epoch, self.sparc_epochs):
+            display_epoch = epoch + 1
+            self.sparc_calibrator.train()
+            losses = []
+            epoch_cache_hits = getattr(self, "_cache_hits", 0)
+            epoch_cache_misses = getattr(self, "_cache_misses", 0)
+            self._log_gpu_status(f"epoch_start dataset={self._dataset_label()} epoch={display_epoch}")
+            with tqdm(total=self.limit_train_batches, desc=f"SPARC epoch {display_epoch}") as progress_bar:
+                for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in self._iter_limited_loader(
+                    self.train_loader,
+                    self.limit_train_batches,
+                ):
+                    batch_x = batch_x.to(self.device).float()
+                    batch_y = batch_y.to(self.device).float()
+                    batch_x_mark = batch_x_mark.to(self.device).float()
+                    batch_y_mark = batch_y_mark.to(self.device).float()
+                    loss = self._sparc_batch_loss(
+                        batch_x,
+                        batch_y,
+                        batch_x_mark,
+                        batch_y_mark,
+                        cache_prefix=self._stable_cache_prefix("train", step),
+                        num_samples=self.stats_num_samples,
+                        sample_batch_size=self.sample_chunk_size,
+                    )
+
+                    optimizer.zero_grad()
+                    loss.backward()
+                    torch.nn.utils.clip_grad_norm_(self.sparc_calibrator.parameters(), 1.0)
+                    optimizer.step()
+
+                    losses.append(float(loss.detach().cpu()))
+                    progress_bar.update(1)
+                    progress_bar.set_postfix(loss=losses[-1])
+
+            scheduler.step()
+
+            if self.check_val_every_n_epoch <= 1 or display_epoch % self.check_val_every_n_epoch == 0:
+                val_loss, val_metrics = self._validate_sparc()
+            else:
+                val_loss = best_loss
+                val_metrics = {}
+            train_loss = float(np.mean(losses)) if losses else float("nan")
+            print(
+                f"[SPARC] epoch={display_epoch} train_loss={train_loss:.6f} val_loss={val_loss:.6f} "
+                f"val_CRPS={val_metrics.get('crps')} val_QICE={val_metrics.get('qice')} "
+                f"cache_hits={getattr(self, '_cache_hits', 0) - epoch_cache_hits} "
+                f"cache_misses={getattr(self, '_cache_misses', 0) - epoch_cache_misses}",
+                flush=True,
+            )
+            self._log_gpu_status(f"epoch_end dataset={self._dataset_label()} epoch={display_epoch}")
+
+            if val_loss < best_loss - self.sparc_min_delta:
+                best_loss = val_loss
+                bad_epochs = 0
+                torch.save({"state_dict": self.sparc_calibrator.state_dict(), "best_val_loss": best_loss}, best_path)
+            else:
+                bad_epochs += 1
+                if bad_epochs >= self.sparc_patience:
+                    print(f"[SPARC] early stopping at epoch={display_epoch}", flush=True)
+                    self._save_resume_checkpoint(last_path, epoch, optimizer, scheduler, best_loss, bad_epochs)
+                    break
+
+            self._save_resume_checkpoint(last_path, epoch, optimizer, scheduler, best_loss, bad_epochs)
+
+        state = _torch_load(best_path, self.device)
+        self.sparc_calibrator.load_state_dict(state["state_dict"])
+        self.sparc_calibrator.eval()
+        return best_path
+
+    def _resume_candidate_path(self) -> Path | None:
+        if self.force_restart or self.resume == "none":
+            return None
+        if self.resume_from:
+            return Path(self.resume_from).expanduser()
+        if self.resume == "auto":
+            return self._default_last_checkpoint()
+        return None
+
+    def _load_resume_checkpoint(self, optimizer, scheduler):
+        path = self._resume_candidate_path()
+        if path is None:
+            reason = "force_restart" if self.force_restart else f"resume={self.resume}"
+            print(f"[FRESH START] dataset={self._dataset_label()}, reason={reason}", flush=True)
+            return None
+        if not path.exists():
+            print(f"[FRESH START] dataset={self._dataset_label()}, reason=missing checkpoint {path}", flush=True)
+            return None
+        state = _torch_load(path, self.device)
+        expected = self._compat_signature()
+        found = state.get("compat_signature")
+        if found != expected:
+            print(
+                f"[FRESH START] dataset={self._dataset_label()}, "
+                f"reason=incompatible checkpoint signature checkpoint={path}",
+                flush=True,
+            )
+            return None
+        try:
+            self.sparc_calibrator.load_state_dict(state["model"])
+            optimizer.load_state_dict(state["optimizer"])
+            scheduler.load_state_dict(state["scheduler"])
+        except Exception as exc:
+            print(
+                f"[FRESH START] dataset={self._dataset_label()}, "
+                f"reason=failed to load checkpoint {path}: {exc}",
+                flush=True,
+            )
+            return None
+        start_epoch = int(state["epoch"]) + 1
+        print(f"[RESUME] dataset={self._dataset_label()}, checkpoint={path}, start_epoch={start_epoch}", flush=True)
+        return {
+            "checkpoint": str(path),
+            "epoch": int(state["epoch"]),
+            "best_val_loss": float(state["best_val_loss"]),
+            "bad_epochs": int(state["bad_epochs"]),
+        }
+
+    def _save_resume_checkpoint(self, path: Path, epoch: int, optimizer, scheduler, best_loss: float, bad_epochs: int) -> None:
+        torch.save(
+            {
+                "epoch": int(epoch),
+                "model": self.sparc_calibrator.state_dict(),
+                "optimizer": optimizer.state_dict(),
+                "scheduler": scheduler.state_dict(),
+                "best_val_loss": float(best_loss),
+                "bad_epochs": int(bad_epochs),
+                "compat_signature": self._compat_signature(),
+            },
+            path,
+        )
+        print(f"[checkpoint] saved last={path} epoch={epoch}", flush=True)
+
+    def _collect_pit_values(self) -> np.ndarray:
+        loader = self.train_loader if self.pit_warp_fit_split == "train" else self.val_loader
+        limit = self.limit_pit_fit_batches if self.pit_warp_fit_split == "train" else self.limit_val_batches
+        values = []
+        total = 0
+        rng = np.random.default_rng(2027)
+        self.sparc_calibrator.eval()
+
+        with torch.no_grad():
+            for step, (batch_x, batch_y, _origin_x, _origin_y, batch_x_mark, batch_y_mark) in self._iter_limited_loader(
+                loader,
+                limit,
+            ):
+                if self.max_pit_fit_points > 0 and total >= self.max_pit_fit_points:
+                    break
+                batch_x = batch_x.to(self.device).float()
+                batch_y = batch_y.to(self.device).float()
+                batch_x_mark = batch_x_mark.to(self.device).float()
+                batch_y_mark = batch_y_mark.to(self.device).float()
+                output_samples = self._sample_timediff(
+                    batch_x,
+                    batch_y,
+                    batch_x_mark,
+                    batch_y_mark,
+                    self.pit_fit_num_samples,
+                    self.pit_sample_batch_size,
+                    f"pit_step{step}_output",
+                )
+                base_stats = self._sample_timediff(
+                    batch_x,
+                    batch_y,
+                    batch_x_mark,
+                    batch_y_mark,
+                    self.pit_fit_num_samples,
+                    self.pit_sample_batch_size,
+                    f"pit_step{step}_base",
+                )
+                aug_stats = self._sample_timediff(
+                    self._seeded_augment_context(batch_x, f"pit_step{step}"),
+                    batch_y,
+                    batch_x_mark,
+                    batch_y_mark,
+                    self.pit_fit_num_samples,
+                    self.pit_sample_batch_size,
+                    f"pit_step{step}_aug",
+                )
+                samples = self.sparc_calibrator.calibrate_samples_with_stats(output_samples, base_stats, aug_stats)
+                pit = compute_sample_pit(samples.detach().cpu().numpy(), self._target(batch_y).detach().cpu().numpy())
+                if self.max_pit_fit_points > 0 and total + pit.size > self.max_pit_fit_points:
+                    keep = self.max_pit_fit_points - total
+                    pit = pit[rng.choice(pit.size, size=keep, replace=False)]
+                values.append(pit)
+                total += pit.size
+                print(
+                    f"[PIT] fit_progress step={step}/{limit} "
+                    f"sample_batch_size={self.pit_sample_batch_size} points={total}",
+                    flush=True,
+                )
+
+        if not values:
+            raise RuntimeError("No PIT values collected")
+        return np.concatenate(values, axis=0)
+
+    def _fit_pit_warp(self, output_root: Path) -> Path:
+        pit = self._collect_pit_values()
+        before = qice_from_pit(pit, n_bins=10)
+        self.pit_warp = PITWarpCalibrator.from_pit(
+            pit,
+            n_knots=self.pit_warp_knots,
+            strength=self.pit_warp_strength,
+        )
+        after = qice_from_pit(self.pit_warp.transform_pit(pit), n_bins=10)
