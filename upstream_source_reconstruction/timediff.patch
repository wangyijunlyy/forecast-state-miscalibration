+def test_managed_launcher_uses_dataset_lock_and_required_log_name():
+    text = (ROOT / "scripts/TimeDiff/run_one_dataset_managed.sh").read_text()
+    assert 'LOCK_DIR="$ROOT/.locks/timeDiff_sparc_${DATASET}"' in text
