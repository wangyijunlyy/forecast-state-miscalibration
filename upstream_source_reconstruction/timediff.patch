+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import ast
+import csv
+from pathlib import Path
+
+
+DATASETS = {
+    "ETTh1": ("ETTh1", 192),
+    "ETTh2": ("ETTh2", 192),
+    "ETTm1": ("ETTm1", 192),
+    "ETTm2": ("ETTm2", 192),
+    "ECL": ("Electricity", 192),
+    "EXG": ("ExchangeRate", 192),
+    "ILI": ("ILI", 36),
+    "Solar": ("SolarEnergy", 192),
+    "Traffic": ("Traffic", 192),
+}
+
+FIELDNAMES = [
+    "dataset",
+    "method",
+    "CRPS",
+    "QICE",
+    "MSE",
+    "MAE",
+    "train_time_min",
+    "peak_memory_MiB",
+]
+
+
+def parse_dict_text(text: str) -> dict[str, float] | None:
+    try:
+        parsed = ast.literal_eval(text.strip())
+    except (SyntaxError, ValueError):
+        return None
+    if not isinstance(parsed, dict):
+        return None
+    return parsed
+
+
+def parse_baseline_metrics(path: Path) -> dict[str, float] | None:
+    found = None
+    if not path.exists():
+        return None
+    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
+        marker = "test_results:"
+        if marker in line:
+            found = parse_dict_text(line.split(marker, 1)[1])
+    return found
+
+
+def parse_metrics_file(path: Path) -> dict[str, float] | None:
+    if not path.exists():
+        return None
+    lines = [line for line in path.read_text(encoding="utf-8", errors="ignore").splitlines() if line.strip()]
+    if not lines:
+        return None
+    return parse_dict_text(lines[-1])
+
+
+def latest_baseline(root: Path, dataset_type: str, pred_len: int, seed: int, windows: int, horizon: int):
+    run_root = root / "results" / "runs" / "TimeDiff" / dataset_type / f"w{windows}h{horizon}s{pred_len}"
+    candidates = sorted(run_root.glob("**/output.log"), key=lambda p: p.stat().st_mtime if p.exists() else 0)
+    for candidate in reversed(candidates):
+        metrics = parse_baseline_metrics(candidate)
+        if metrics:
+            return metrics
+    return None
+
+
+def sparc_metrics(root: Path, dataset_type: str, pred_len: int, seed: int, windows: int, horizon: int):
+    path = (
+        root
+        / "results"
+        / "sparc_pit"
+        / f"TimeDiff_{dataset_type}_w{windows}h{horizon}s{pred_len}_seed{seed}_managed"
+        / "sparc_pit_test_metrics.txt"
+    )
+    return parse_metrics_file(path)
+
+
+def load_metadata(root: Path):
+    metadata: dict[tuple[str, str], tuple[str, str]] = {}
+    path = root / "results" / "run_metadata.csv"
+    if not path.exists():
+        return metadata
+    with path.open(newline="", encoding="utf-8") as f:
+        for row in csv.DictReader(f):
+            key = (row.get("dataset", ""), row.get("method", ""))
+            metadata[key] = (row.get("train_time_min", ""), row.get("peak_memory_MiB", ""))
+    return metadata
+
+
+def value(metrics: dict[str, float] | None, key: str) -> str:
+    if not metrics:
+        return ""
+    for candidate in (key, key.lower()):
+        if candidate in metrics:
+            return str(metrics[candidate])
+    return ""
+
+
+def row(label: str, dataset_type: str, method: str, metrics: dict[str, float] | None, metadata):
+    train_time, peak = metadata.get((dataset_type, method), ("", ""))
+    return {
+        "dataset": label,
+        "method": method,
+        "CRPS": value(metrics, "CRPS"),
+        "QICE": value(metrics, "QICE"),
+        "MSE": value(metrics, "MSE"),
+        "MAE": value(metrics, "MAE"),
+        "train_time_min": train_time,
+        "peak_memory_MiB": peak,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path.cwd())
+    parser.add_argument("--datasets", default=",".join(DATASETS))
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--windows", type=int, default=168)
+    parser.add_argument("--horizon", type=int, default=1)
+    parser.add_argument("--output", type=Path, default=Path("results_comparison.csv"))
+    args = parser.parse_args()
+
+    labels = [item.strip() for item in args.datasets.replace(" ", ",").split(",") if item.strip()]
+    metadata = load_metadata(args.root)
+    rows = []
+    for label in labels:
+        dataset_type, pred_len = DATASETS[label]
+        base = latest_baseline(args.root, dataset_type, pred_len, args.seed, args.windows, args.horizon)
+        sparc = sparc_metrics(args.root, dataset_type, pred_len, args.seed, args.windows, args.horizon)
+        rows.append(row(label, dataset_type, "TimeDiff", base, metadata))
+        rows.append(row(label, dataset_type, "TimeDiff-SPARC", sparc, metadata))
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
+        writer.writeheader()
+        writer.writerows(rows)
+    print(args.output)
+
+
+if __name__ == "__main__":
+    main()
