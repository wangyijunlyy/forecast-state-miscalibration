+  echo "[$(date)] sparc_start dataset=${DATASET} gpu=${GPU_ID} batch_size=${batch} sample_chunk_size=${SAMPLE_CHUNK_SIZE} checkpoint=${ckpt}" | tee -a "$LOG_FILE"
+  start_ts="$(date +%s)"
+  start_memory_monitor
+  set +e
+  PYTHONUNBUFFERED=1 python -u ./src/experiments/TimeDiff_SPARC_PIT.py \
+    --dataset_type="$DATASET" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --num_worker="$NUM_WORKERS" \
+    --horizon="$HORIZON" \
+    --pred_len="$PRED_LEN" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --num_steps="$NUM_STEPS" \
+    --beta_start="$BETA_START" \
+    --beta_end="$BETA_END" \
+    --schedule="$SCHEDULE" \
+    --checkpoint_dir="$ckpt" \
+    --output_dir="$out_dir" \
+    --stats_num_samples="$STATS_NUM_SAMPLES" \
+    --eval_num_samples="$EVAL_NUM_SAMPLES" \
+    --sample_chunk_size="$SAMPLE_CHUNK_SIZE" \
+    --sparc_epochs="$SPARC_EPOCHS" \
+    --sparc_patience="$SPARC_PATIENCE" \
+    --sparc_min_delta="$SPARC_MIN_DELTA" \
+    --check_val_every_n_epoch="$CHECK_VAL_EVERY_N_EPOCH" \
+    --limit_train_batches="$LIMIT_TRAIN_BATCHES" \
+    --limit_pit_fit_batches="$LIMIT_PIT_FIT_BATCHES" \
+    --limit_val_batches="$LIMIT_VAL_BATCHES" \
+    --pit_fit_num_samples="$PIT_FIT_NUM_SAMPLES" \
+    --pit_sample_batch_size="$PIT_SAMPLE_BATCH_SIZE" \
+    --val_num_samples="$VAL_NUM_SAMPLES" \
+    --val_sample_batch_size="$VAL_SAMPLE_BATCH_SIZE" \
+    --val_fixed_seed="$VAL_FIXED_SEED" \
+    --final_test_num_samples="$FINAL_TEST_NUM_SAMPLES" \
+    --cache_timediff_predictions="$CACHE_TIMEDIFF_PREDICTIONS" \
+    --cache_sorted_samples="$CACHE_SORTED_SAMPLES" \
+    --cache_dtype="$CACHE_DTYPE" \
+    --pin_memory="$PIN_MEMORY" \
+    --persistent_workers="$PERSISTENT_WORKERS" \
+    --prefetch_factor="$PREFETCH_FACTOR" \
+    --resume="$RESUME" \
+    --resume_from="$RESUME_FROM" \
+    --force_restart="$FORCE_RESTART" \
+    --reuse_cache="$REUSE_CACHE" \
+    --rebuild_cache="$REBUILD_CACHE" \
+    --pit_warp_strength="$PIT_WARP_STRENGTH" \
+    run --seed="$SEED" >>"$LOG_FILE" 2>&1
+  status=$?
+  set -e
+  stop_memory_monitor
+  end_ts="$(date +%s)"
+  record_meta "TimeDiff-SPARC" "$batch" "$start_ts" "$end_ts"
+  grep -E '^\[SPARC\] epoch=' "$LOG_FILE" >"$SPARC_EPOCH_LOG" || true
+  grep -E '^\[PIT\]' "$LOG_FILE" >"$PIT_LOG" || true
+  if [[ "$status" -ne 0 ]] && grep -qi 'out of memory' "$LOG_FILE"; then
+    return 88
+  fi
+  return "$status"
+}
+
+run_with_retries() {
+  local method="$1"
+  local batch status
+  if [[ "$method" == "baseline" ]] && [[ -n "$(checkpoint_for || true)" ]]; then
+    echo "[$(date)] baseline_done dataset=${DATASET} existing_checkpoint=$(checkpoint_for)" | tee -a "$LOG_FILE"
+    return 0
+  fi
+  for batch in $BATCH_CANDIDATES; do
+    if [[ "$method" == "baseline" ]]; then
+      run_baseline_once "$batch"
+    else
+      run_sparc_once "$batch"
+    fi
+    status=$?
+    if [[ "$status" -eq 0 ]]; then
+      echo "[$(date)] ${method}_done dataset=${DATASET} batch_size=${batch}" | tee -a "$LOG_FILE"
+      return 0
+    fi
+    if [[ "$status" -eq 88 ]]; then
+      echo "[$(date)] ${method}_oom_retry dataset=${DATASET} failed_batch=${batch}" | tee -a "$LOG_FILE"
+      continue
+    fi
+    return "$status"
+  done
+  return 88
+}
+
+echo "[$(date)] managed_start dataset=${DATASET} gpu=${GPU_ID} pred_len=${PRED_LEN} seed=${SEED}" | tee "$LOG_FILE"
+run_with_retries baseline
+run_with_retries sparc
+echo "[$(date)] managed_done dataset=${DATASET} gpu=${GPU_ID}" | tee -a "$LOG_FILE"
