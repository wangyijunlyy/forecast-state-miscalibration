+import numpy as np
+import torch
+
+from src.sparc_pit import PITWarpCalibrator, compute_sample_pit
+from src.experiments.TimeDiff_SPARC_PIT import TimeDiffSPARCPITForecast
+
+
+def test_pit_warp_preserves_sample_shape():
+    samples = np.arange(2 * 5 * 3 * 1, dtype=np.float64).reshape(2, 5, 3, 1)
+    pit = np.linspace(0.05, 0.95, 50)
+    warp = PITWarpCalibrator.from_pit(pit, n_knots=11, strength=1.0)
+
+    warped = warp.warp_samples(samples)
+
+    assert warped.shape == samples.shape
+
+
+def test_compute_sample_pit_shape_contract():
+    samples = np.array([[[[0.0], [2.0]], [[1.0], [3.0]]]])
+    targets = np.array([[[0.5], [4.0]]])
+
+    pit = compute_sample_pit(samples, targets)
+
+    assert pit.tolist() == [0.5, 1.0]
+
+
+def test_process_val_batch_returns_metric_layout():
+    exp = TimeDiffSPARCPITForecast.__new__(TimeDiffSPARCPITForecast)
+    exp.device = "cpu"
+    exp.pred_len = 3
+    exp.eval_num_samples = 4
+    exp.stats_num_samples = 4
+    exp.final_test_num_samples = 4
+    exp.sample_chunk_size = 2
+    exp.jitter_std = 0.0
+    exp.scaling_std = 0.0
+    exp.time_mask_ratio = 0.0
+
+    class Dataset:
+        num_features = 1
+
+    class IdentityCalibrator:
+        def calibrate_samples_with_stats(self, samples, base_stats, aug_stats):
+            return samples + 1.0
+
+    exp.dataset = Dataset()
+    exp.sparc_calibrator = IdentityCalibrator()
+
+    batch_x = torch.zeros(2, 5, 1)
+    batch_y = torch.zeros(2, 3, 1)
+    batch_mark = torch.zeros(2, 3, 1)
+
+    def fake_sample(batch_x_arg, batch_y_arg, batch_x_mark_arg, batch_y_mark_arg, num_samples, *args, **kwargs):
+        return torch.zeros(batch_x_arg.shape[0], num_samples, exp.pred_len, 1)
+
+    exp._sample_timediff = fake_sample
+
+    samples, target = exp._process_val_batch(batch_x, batch_y, batch_mark, batch_mark)
+
+    assert samples.shape == (2, 3, 1, 4)
+    assert target.shape == (2, 3, 1)
+    assert torch.allclose(samples, torch.ones_like(samples))
+
+
+def test_sparc_defaults_keep_full_pit_and_final_test_but_shrink_epoch_validation():
+    exp = TimeDiffSPARCPITForecast()
+
+    assert exp.limit_train_batches == 100
+    assert exp.limit_pit_fit_batches == 100
+    assert exp.limit_val_batches == 20
+    assert exp.sparc_epochs == 5
+    assert exp.sparc_patience == 1
+    assert exp.sparc_min_delta == 0.0005
+    assert exp.pit_fit_num_samples == 100
+    assert exp.pit_sample_batch_size == 20
+    assert exp.val_num_samples == 20
+    assert exp.val_sample_batch_size == 20
+    assert exp.val_fixed_seed == 2026
+    assert exp.final_test_num_samples == 100
+
+
+def test_string_boolean_flags_are_normalized():
+    exp = TimeDiffSPARCPITForecast()
+    exp.rebuild_cache = "false"
+    exp.reuse_cache = "true"
+    exp.force_restart = "0"
+
+    exp._normalize_runtime_flags()
+
+    assert exp.rebuild_cache is False
+    assert exp.reuse_cache is True
+    assert exp.force_restart is False
+
+
+def test_sample_cache_reuses_timediff_prediction(tmp_path):
+    exp = TimeDiffSPARCPITForecast.__new__(TimeDiffSPARCPITForecast)
+    exp.device = "cpu"
+    exp.pred_len = 3
+    exp.sample_chunk_size = 2
+    exp.cache_timediff_predictions = True
+    exp.cache_sorted_samples = True
+    exp.cache_dtype = "float16"
+    exp._prediction_cache_root = tmp_path
+    exp._sample_calls = 0
+    exp._cache_metadata = lambda cache_key, num_samples: {"cache_key": cache_key, "num_samples": num_samples}
+    exp._dataset_label = lambda: "ECL"
+
+    class Dataset:
+        num_features = 1
+
+    exp.dataset = Dataset()
+
+    def fake_uncached(batch_x, batch_y, batch_x_mark, batch_y_mark, num_samples, sample_batch_size=None):
+        exp._sample_calls += 1
+        return torch.full((batch_x.shape[0], num_samples, exp.pred_len, 1), float(exp._sample_calls))
+
+    exp._sample_timediff_uncached = fake_uncached
+    batch_x = torch.zeros(2, 5, 1)
+    batch_y = torch.zeros(2, 3, 1)
+    batch_mark = torch.zeros(2, 3, 1)
+
+    first = exp._sample_timediff_cached(
+        "val_step1_base", batch_x, batch_y, batch_mark, batch_mark, num_samples=4, sample_batch_size=2
+    )
+    second = exp._sample_timediff_cached(
+        "val_step1_base", batch_x, batch_y, batch_mark, batch_mark, num_samples=4, sample_batch_size=2
+    )
+
+    assert exp._sample_calls == 1
+    assert first.dtype == torch.float32
+    assert torch.allclose(first, second)
+
+
+def test_train_cache_prefix_is_stable_across_sparc_epochs():
+    exp = TimeDiffSPARCPITForecast.__new__(TimeDiffSPARCPITForecast)
+
+    assert exp._stable_cache_prefix("train", 7) == "train_step7"
+    assert "epoch" not in exp._stable_cache_prefix("train", 7)
+
+
+def test_seeded_augment_context_is_stable_for_same_cache_key():
+    exp = TimeDiffSPARCPITForecast.__new__(TimeDiffSPARCPITForecast)
+    exp.jitter_std = 0.1
+    exp.scaling_std = 0.1
+    exp.time_mask_ratio = 0.1
+    exp.val_fixed_seed = 2026
+
+    batch_x = torch.ones(2, 8, 1)
+
+    first = exp._seeded_augment_context(batch_x, "train_step1")
+    second = exp._seeded_augment_context(batch_x, "train_step1")
+
+    assert torch.allclose(first, second)
+
+
+def test_resume_checkpoint_uses_completed_epoch_plus_one(tmp_path):
+    exp = TimeDiffSPARCPITForecast()
+    exp.dataset_type = "Electricity"
+    exp.pred_len = 3
+    exp.resume = "auto"
+    exp.resume_from = str(tmp_path / "last.pt")
+    exp.force_restart = False
+    exp.sparc_hidden_dim = 4
+    exp.sparc_calibrator = torch.nn.Linear(1, 1)
+
+    class Dataset:
+        num_features = 1
+
+    exp.dataset = Dataset()
+    optimizer = torch.optim.Adam(exp.sparc_calibrator.parameters(), lr=0.01)
+    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda=lambda _epoch: 1.0)
+    torch.save(
+        {
+            "epoch": 1,
+            "model": exp.sparc_calibrator.state_dict(),
+            "optimizer": optimizer.state_dict(),
+            "scheduler": scheduler.state_dict(),
+            "best_val_loss": 0.5,
+            "bad_epochs": 1,
+            "compat_signature": exp._compat_signature(),
+        },
+        exp.resume_from,
+    )
+
+    state = exp._load_resume_checkpoint(optimizer, scheduler)
+
+    assert state["epoch"] == 1
+    assert state["bad_epochs"] == 1
