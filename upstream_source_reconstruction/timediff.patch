+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import ast
+import csv
+from pathlib import Path
+
+
+DATASETS = [
+    ("ETTh1", "ETTh1", 192),
+    ("ETTh2", "ETTh2", 192),
+    ("ETTm1", "ETTm1", 192),
+    ("ETTm2", "ETTm2", 192),
+    ("ECL", "Electricity", 192),
+    ("EXG", "ExchangeRate", 192),
+    ("ILI", "ILI", 36),
+    ("Solar", "SolarEnergy", 192),
+    ("Traffic", "Traffic", 192),
+]
+
+
+def parse_last_metrics_from_log(path: Path) -> dict[str, float] | None:
+    if not path.exists():
+        return None
+    found = None
+    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
+        marker = "test_results:"
+        if marker not in line:
+            continue
+        try:
+            found = ast.literal_eval(line.split(marker, 1)[1].strip())
+        except (SyntaxError, ValueError):
+            continue
+    return found
+
+
+def parse_metrics_file(path: Path) -> dict[str, float] | None:
+    if not path.exists():
+        return None
+    lines = [line.strip() for line in path.read_text(encoding="utf-8", errors="ignore").splitlines() if line.strip()]
+    if not lines:
+        return None
+    try:
+        return ast.literal_eval(lines[-1])
+    except (SyntaxError, ValueError):
+        return None
+
+
+def latest_baseline(root: Path, dataset: str, windows: int, horizon: int, pred_len: int, seed: int):
+    run_root = root / "results" / "runs" / "TimeDiff" / dataset / f"w{windows}h{horizon}s{pred_len}" / str(seed)
+    logs = sorted(run_root.glob("**/output.log"), key=lambda p: p.stat().st_mtime if p.exists() else 0)
+    for log in reversed(logs):
+        metrics = parse_last_metrics_from_log(log)
+        if metrics:
+            return log.parent, metrics
+    return None, None
+
+
+def latest_sparc(root: Path, dataset: str, windows: int, horizon: int, pred_len: int, seed: int):
+    path = (
+        root
+        / "results"
+        / "sparc_pit"
+        / f"TimeDiff_{dataset}_w{windows}h{horizon}s{pred_len}_seed{seed}_fresh"
+        / "sparc_pit_test_metrics.txt"
+    )
+    metrics = parse_metrics_file(path)
+    if metrics:
+        return path.parent, metrics
+    return None, None
+
+
+def metric_row(label: str, dataset: str, seed: int, method: str, path: Path | None, metrics: dict[str, float] | None):
+    row = {
+        "dataset": label,
+        "dataset_type": dataset,
+        "seed": seed,
+        "method": method,
+        "status": "ok" if metrics else "missing",
+        "crps": "",
+        "qice": "",
+        "mse": "",
+        "mae": "",
+        "rmse": "",
+        "path": str(path) if path else "",
+    }
+    if metrics:
+        for key in ("crps", "qice", "mse", "mae", "rmse"):
+            row[key] = metrics.get(key, "")
+    return row
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path.cwd())
+    parser.add_argument("--seeds", default="1 2 3")
+    parser.add_argument("--windows", type=int, default=168)
+    parser.add_argument("--horizon", type=int, default=1)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    seeds = [int(seed) for seed in args.seeds.replace(",", " ").split()]
+    rows = []
+    for seed in seeds:
+        for label, dataset, pred_len in DATASETS:
+            base_path, base_metrics = latest_baseline(args.root, dataset, args.windows, args.horizon, pred_len, seed)
+            sparc_path, sparc_metrics = latest_sparc(args.root, dataset, args.windows, args.horizon, pred_len, seed)
+            rows.append(metric_row(label, dataset, seed, "TimeDiff", base_path, base_metrics))
+            rows.append(metric_row(label, dataset, seed, "TimeDiff-SPARC-PIT", sparc_path, sparc_metrics))
+            if base_metrics and sparc_metrics:
+                rows.append(
+                    {
+                        "dataset": label,
+                        "dataset_type": dataset,
+                        "seed": seed,
+                        "method": "delta(SPARC-PIT - TimeDiff)",
+                        "status": "ok",
+                        "crps": sparc_metrics["crps"] - base_metrics["crps"],
+                        "qice": sparc_metrics["qice"] - base_metrics["qice"],
+                        "mse": sparc_metrics["mse"] - base_metrics["mse"],
+                        "mae": sparc_metrics["mae"] - base_metrics["mae"],
+                        "rmse": sparc_metrics["rmse"] - base_metrics["rmse"],
+                        "path": "",
+                    }
+                )
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(
+            f,
+            fieldnames=["dataset", "dataset_type", "seed", "method", "status", "crps", "qice", "mse", "mae", "rmse", "path"],
+        )
+        writer.writeheader()
+        writer.writerows(rows)
+    print(args.output)
+
+
+if __name__ == "__main__":
+    main()
