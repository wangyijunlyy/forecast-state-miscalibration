+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="${ROOT:-$HOME/SPARC/NsDiff_TimeDiff_SPARC_PIT_Fresh}"
+DATASET="${1:?dataset_type is required}"
+GPU_ID="${2:?gpu id is required}"
+PRED_LEN="${3:-192}"
+SEED="${SEED:-1}"
+WINDOWS="${WINDOWS:-168}"
+HORIZON="${HORIZON:-1}"
+EPOCHS="${EPOCHS:-10}"
+PATIENCE="${PATIENCE:-5}"
+NUM_WORKERS="${NUM_WORKERS:-8}"
+NUM_STEPS="${NUM_STEPS:-20}"
+BETA_START="${BETA_START:-0.0001}"
+BETA_END="${BETA_END:-0.02}"
+SCHEDULE="${SCHEDULE:-linear}"
+SPARC_EPOCHS="${SPARC_EPOCHS:-5}"
+SPARC_PATIENCE="${SPARC_PATIENCE:-1}"
+SPARC_MIN_DELTA="${SPARC_MIN_DELTA:-0.0005}"
+CHECK_VAL_EVERY_N_EPOCH="${CHECK_VAL_EVERY_N_EPOCH:-1}"
+LIMIT_TRAIN_BATCHES="${LIMIT_TRAIN_BATCHES:-100}"
+LIMIT_PIT_FIT_BATCHES="${LIMIT_PIT_FIT_BATCHES:-100}"
+LIMIT_VAL_BATCHES="${LIMIT_VAL_BATCHES:-20}"
+STATS_NUM_SAMPLES="${STATS_NUM_SAMPLES:-100}"
+EVAL_NUM_SAMPLES="${EVAL_NUM_SAMPLES:-100}"
+SAMPLE_CHUNK_SIZE="${SAMPLE_CHUNK_SIZE:-20}"
+PIT_FIT_NUM_SAMPLES="${PIT_FIT_NUM_SAMPLES:-100}"
+PIT_SAMPLE_BATCH_SIZE="${PIT_SAMPLE_BATCH_SIZE:-20}"
+VAL_NUM_SAMPLES="${VAL_NUM_SAMPLES:-20}"
+VAL_SAMPLE_BATCH_SIZE="${VAL_SAMPLE_BATCH_SIZE:-20}"
+VAL_FIXED_SEED="${VAL_FIXED_SEED:-2026}"
+FINAL_TEST_NUM_SAMPLES="${FINAL_TEST_NUM_SAMPLES:-100}"
+CACHE_TIMEDIFF_PREDICTIONS="${CACHE_TIMEDIFF_PREDICTIONS:-true}"
+CACHE_SORTED_SAMPLES="${CACHE_SORTED_SAMPLES:-true}"
+CACHE_DTYPE="${CACHE_DTYPE:-float16}"
+PIN_MEMORY="${PIN_MEMORY:-true}"
+PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-true}"
+PREFETCH_FACTOR="${PREFETCH_FACTOR:-4}"
+RESUME="${RESUME:-auto}"
+RESUME_FROM="${RESUME_FROM:-}"
+FORCE_RESTART="${FORCE_RESTART:-false}"
+REUSE_CACHE="${REUSE_CACHE:-true}"
+REBUILD_CACHE="${REBUILD_CACHE:-false}"
+PIT_WARP_STRENGTH="${PIT_WARP_STRENGTH:-1.0}"
+BATCH_CANDIDATES="${BATCH_CANDIDATES:-16 8 4 2 1}"
+
+mkdir -p "$ROOT/.locks" "$ROOT/logs" "$ROOT/results"
+LOCK_DIR="$ROOT/.locks/timeDiff_sparc_${DATASET}"
+if mkdir "$LOCK_DIR"; then
+  echo "$$" >"$LOCK_DIR/pid"
+  trap 'rm -rf "$LOCK_DIR"' EXIT
+else
+  old_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
+  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
+    echo "[$(date)] duplicate blocked dataset=${DATASET} live_pid=${old_pid}"
+    exit 23
+  fi
+  rm -rf "$LOCK_DIR"
+  mkdir "$LOCK_DIR"
+  echo "$$" >"$LOCK_DIR/pid"
+  trap 'rm -rf "$LOCK_DIR"' EXIT
+fi
+
+LOG_FILE="$ROOT/logs/timeDiff_sparc_${DATASET}_gpu${GPU_ID}.log"
+BASE_EPOCH_LOG="$ROOT/logs/timeDiff_epoch_loss_${DATASET}_baseline.log"
+SPARC_EPOCH_LOG="$ROOT/logs/timeDiff_epoch_loss_${DATASET}_sparc.log"
+PIT_LOG="$ROOT/logs/timeDiff_pit_fit_${DATASET}.log"
+META_FILE="$ROOT/results/run_metadata.csv"
+PEAK_FILE="$ROOT/logs/timeDiff_sparc_${DATASET}_gpu${GPU_ID}.peak"
+
+cd "$ROOT"
+source "$HOME/miniconda3/etc/profile.d/conda.sh" 2>/dev/null \
+  || source "$HOME/anaconda3/etc/profile.d/conda.sh" 2>/dev/null \
+  || source /opt/conda/etc/profile.d/conda.sh
+conda activate k2vae
+
+export PYTHONPATH=./
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export CUDA_VISIBLE_DEVICES="$GPU_ID"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+
+if [[ ! -s "$META_FILE" ]]; then
+  echo "dataset,method,seed,gpu,batch_size,train_time_min,peak_memory_MiB,log_file" >"$META_FILE"
+fi
+
+checkpoint_for() {
+  find "results/runs/TimeDiff/${DATASET}/w${WINDOWS}h${HORIZON}s${PRED_LEN}" \
+    -type f \( -name best_model.pth -o -name model.pth \) 2>/dev/null \
+    -printf '%T@ %p\n' \
+    | sort -n \
+    | tail -n 1 \
+    | cut -d' ' -f2- \
+    | xargs -r dirname
+}
+
+start_memory_monitor() {
+  : >"$PEAK_FILE"
+  (
+    peak=0
+    while true; do
+      used="$(nvidia-smi --id="$GPU_ID" --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d ' ' || echo 0)"
+      [[ "$used" =~ ^[0-9]+$ ]] || used=0
+      if (( used > peak )); then
+        peak="$used"
+        echo "$peak" >"$PEAK_FILE"
+      fi
+      sleep 5
+    done
+  ) &
+  MONITOR_PID=$!
+}
+
+stop_memory_monitor() {
+  if [[ -n "${MONITOR_PID:-}" ]]; then
+    kill "$MONITOR_PID" 2>/dev/null || true
+    wait "$MONITOR_PID" 2>/dev/null || true
+    MONITOR_PID=""
+  fi
+}
+
+record_meta() {
+  local method="$1"
+  local batch="$2"
+  local start_ts="$3"
+  local end_ts="$4"
+  local peak="0"
+  [[ -s "$PEAK_FILE" ]] && peak="$(cat "$PEAK_FILE")"
+  awk -v ds="$DATASET" -v m="$method" -v seed="$SEED" -v gpu="$GPU_ID" -v bs="$batch" \
+    -v s="$start_ts" -v e="$end_ts" -v peak="$peak" -v log="$LOG_FILE" \
+    'BEGIN { printf "%s,%s,%s,%s,%s,%.2f,%s,%s\n", ds,m,seed,gpu,bs,(e-s)/60.0,peak,log }' >>"$META_FILE"
+}
+
+run_baseline_once() {
+  local batch="$1"
+  echo "[$(date)] baseline_start dataset=${DATASET} gpu=${GPU_ID} batch_size=${batch}" | tee -a "$LOG_FILE"
+  local start_ts end_ts status
+  start_ts="$(date +%s)"
+  start_memory_monitor
+  set +e
+  PYTHONUNBUFFERED=1 python -u ./src/experiments/TimeDiff.py \
+    --dataset_type="$DATASET" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --num_worker="$NUM_WORKERS" \
+    --horizon="$HORIZON" \
+    --pred_len="$PRED_LEN" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --num_steps="$NUM_STEPS" \
+    --beta_start="$BETA_START" \
+    --beta_end="$BETA_END" \
+    --schedule="$SCHEDULE" \
