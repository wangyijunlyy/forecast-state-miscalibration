+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="${ROOT:-$HOME/SPARC/NsDiff_TimeDiff_SPARC_PIT_Fresh}"
+LOG_ROOT="${LOG_ROOT:-$ROOT/logs/fresh_timediff_sparc_pit_$(date +%Y%m%d_%H%M%S)}"
+SEEDS="${SEEDS:-1 2 3}"
+WINDOWS="${WINDOWS:-168}"
+HORIZON="${HORIZON:-1}"
+BATCH_SIZE="${BATCH_SIZE:-32}"
+EPOCHS="${EPOCHS:-10}"
+PATIENCE="${PATIENCE:-5}"
+NUM_WORKERS="${NUM_WORKERS:-8}"
+MAX_PARALLEL="${MAX_PARALLEL:-2}"
+NUM_STEPS="${NUM_STEPS:-20}"
+BETA_START="${BETA_START:-0.0001}"
+BETA_END="${BETA_END:-0.02}"
+SCHEDULE="${SCHEDULE:-linear}"
+
+SPARC_EPOCHS="${SPARC_EPOCHS:-10}"
+SPARC_PATIENCE="${SPARC_PATIENCE:-5}"
+CHECK_VAL_EVERY_N_EPOCH="${CHECK_VAL_EVERY_N_EPOCH:-1}"
+LIMIT_TRAIN_BATCHES="${LIMIT_TRAIN_BATCHES:-100}"
+LIMIT_PIT_FIT_BATCHES="${LIMIT_PIT_FIT_BATCHES:-100}"
+LIMIT_VAL_BATCHES="${LIMIT_VAL_BATCHES:-100}"
+EVAL_NUM_SAMPLES="${EVAL_NUM_SAMPLES:-100}"
+STATS_NUM_SAMPLES="${STATS_NUM_SAMPLES:-100}"
+SAMPLE_CHUNK_SIZE="${SAMPLE_CHUNK_SIZE:-20}"
+PIT_WARP_STRENGTH="${PIT_WARP_STRENGTH:-1.0}"
+
+mkdir -p "$LOG_ROOT"
+cd "$ROOT"
+
+source "$HOME/miniconda3/etc/profile.d/conda.sh" 2>/dev/null \
+  || source "$HOME/anaconda3/etc/profile.d/conda.sh" 2>/dev/null \
+  || source /opt/conda/etc/profile.d/conda.sh
+conda activate k2vae
+
+export PYTHONPATH=./
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+
+checkpoint_for() {
+  local dataset="$1"
+  local pred_len="$2"
+  local seed="$3"
+  find "results/runs/TimeDiff/${dataset}/w${WINDOWS}h${HORIZON}s${pred_len}" \
+    -maxdepth 2 -type f \( -name best_model.pth -o -name model.pth \) 2>/dev/null \
+    | grep "/${seed}/" \
+    | sort \
+    | tail -n 1 \
+    | xargs -r dirname
+}
+
+run_baseline_once() {
+  local dataset="$1"
+  local pred_len="$2"
+  local seed="$3"
+  local gpu="$4"
+  local batch="$5"
+  local log="$LOG_ROOT/baseline_${dataset}_seed${seed}_gpu${gpu}_bs${batch}.log"
+
+  if [[ -n "$(checkpoint_for "$dataset" "$pred_len" "$seed" || true)" ]]; then
+    echo "[$(date)] baseline exists dataset=${dataset} seed=${seed}" | tee -a "$log"
+    return 0
+  fi
+
+  echo "[$(date)] start baseline dataset=${dataset} pred_len=${pred_len} seed=${seed} gpu=${gpu} batch=${batch}" | tee "$log"
+  set +e
+  CUDA_VISIBLE_DEVICES="$gpu" PYTHONUNBUFFERED=1 python -u ./src/experiments/TimeDiff.py \
+    --dataset_type="$dataset" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --num_worker="$NUM_WORKERS" \
+    --horizon="$HORIZON" \
+    --pred_len="$pred_len" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --num_steps="$NUM_STEPS" \
+    --beta_start="$BETA_START" \
+    --beta_end="$BETA_END" \
+    --schedule="$SCHEDULE" \
+    runs --seeds="[$seed]" >>"$log" 2>&1
+  local status=$?
+  set -e
+  if [[ "$status" -ne 0 ]] && grep -qi 'out of memory' "$log"; then
+    return 88
+  fi
+  return "$status"
+}
+
+run_baseline() {
+  local dataset="$1"
+  local pred_len="$2"
+  local seed="$3"
+  local gpu="$4"
+  local batch status
+  for batch in "$BATCH_SIZE" 16 8 4 2 1; do
+    run_baseline_once "$dataset" "$pred_len" "$seed" "$gpu" "$batch"
+    status=$?
+    if [[ "$status" -eq 0 ]]; then
+      return 0
+    fi
+    if [[ "$status" -eq 88 ]]; then
+      echo "[$(date)] baseline OOM dataset=${dataset} seed=${seed} batch=${batch}; retry smaller" | tee -a "$LOG_ROOT/oom_retries.log"
+      continue
+    fi
+    return "$status"
+  done
+  return 88
+}
+
+run_sparc_once() {
+  local dataset="$1"
+  local pred_len="$2"
+  local seed="$3"
+  local gpu="$4"
+  local batch="$5"
+  local ckpt out_dir log
+
+  ckpt="$(checkpoint_for "$dataset" "$pred_len" "$seed" || true)"
+  out_dir="./results/sparc_pit/TimeDiff_${dataset}_w${WINDOWS}h${HORIZON}s${pred_len}_seed${seed}_fresh"
+  log="$LOG_ROOT/sparc_${dataset}_seed${seed}_gpu${gpu}_bs${batch}.log"
+
+  if [[ -z "$ckpt" ]]; then
+    echo "[$(date)] ERROR missing baseline checkpoint dataset=${dataset} seed=${seed}" | tee "$log"
+    return 1
+  fi
+  if [[ -s "$out_dir/sparc_pit_test_metrics.txt" ]]; then
+    echo "[$(date)] SPARC-PIT exists dataset=${dataset} seed=${seed}" | tee -a "$log"
+    return 0
+  fi
+
+  echo "[$(date)] start SPARC-PIT dataset=${dataset} pred_len=${pred_len} seed=${seed} gpu=${gpu} batch=${batch} checkpoint=${ckpt}" | tee "$log"
+  set +e
+  CUDA_VISIBLE_DEVICES="$gpu" PYTHONUNBUFFERED=1 python -u ./src/experiments/TimeDiff_SPARC_PIT.py \
+    --dataset_type="$dataset" \
+    --device="cuda:0" \
+    --batch_size="$batch" \
+    --data_path="./data" \
+    --num_worker="$NUM_WORKERS" \
+    --horizon="$HORIZON" \
+    --pred_len="$pred_len" \
+    --windows="$WINDOWS" \
+    --epochs="$EPOCHS" \
+    --patience="$PATIENCE" \
+    --num_steps="$NUM_STEPS" \
+    --beta_start="$BETA_START" \
+    --beta_end="$BETA_END" \
+    --schedule="$SCHEDULE" \
+    --checkpoint_dir="$ckpt" \
+    --output_dir="$out_dir" \
+    --stats_num_samples="$STATS_NUM_SAMPLES" \
+    --eval_num_samples="$EVAL_NUM_SAMPLES" \
+    --sample_chunk_size="$SAMPLE_CHUNK_SIZE" \
+    --sparc_epochs="$SPARC_EPOCHS" \
+    --sparc_patience="$SPARC_PATIENCE" \
+    --check_val_every_n_epoch="$CHECK_VAL_EVERY_N_EPOCH" \
+    --limit_train_batches="$LIMIT_TRAIN_BATCHES" \
+    --limit_pit_fit_batches="$LIMIT_PIT_FIT_BATCHES" \
+    --limit_val_batches="$LIMIT_VAL_BATCHES" \
+    --pit_warp_strength="$PIT_WARP_STRENGTH" \
+    run --seed="$seed" >>"$log" 2>&1
+  local status=$?
+  set -e
+  if [[ "$status" -ne 0 ]] && grep -qi 'out of memory' "$log"; then
+    return 88
+  fi
+  return "$status"
+}
+
+run_sparc() {
+  local dataset="$1"
+  local pred_len="$2"
+  local seed="$3"
+  local gpu="$4"
+  local batch status
+  for batch in "$BATCH_SIZE" 16 8 4 2 1; do
+    run_sparc_once "$dataset" "$pred_len" "$seed" "$gpu" "$batch"
+    status=$?
+    if [[ "$status" -eq 0 ]]; then
+      return 0
+    fi
+    if [[ "$status" -eq 88 ]]; then
+      echo "[$(date)] SPARC OOM dataset=${dataset} seed=${seed} batch=${batch}; retry smaller" | tee -a "$LOG_ROOT/oom_retries.log"
+      continue
+    fi
+    return "$status"
+  done
+  return 88
+}
+
+run_task() {
+  local task="$1"
+  local gpu="$2"
+  local dataset pred_len seed
+  IFS=: read -r dataset pred_len seed <<<"$task"
+  run_baseline "$dataset" "$pred_len" "$seed" "$gpu"
+  run_sparc "$dataset" "$pred_len" "$seed" "$gpu"
+}
+
+tasks=()
+for seed in $SEEDS; do
+  tasks+=("ETTh1:192:$seed")
+  tasks+=("ETTh2:192:$seed")
+  tasks+=("ETTm1:192:$seed")
+  tasks+=("ETTm2:192:$seed")
+  tasks+=("Electricity:192:$seed")
+  tasks+=("ExchangeRate:192:$seed")
+  tasks+=("ILI:36:$seed")
+  tasks+=("SolarEnergy:192:$seed")
+  tasks+=("Traffic:192:$seed")
+done
+
+worker() {
+  local worker_id="$1"
+  local gpu="$2"
+  local i
+  for i in "${!tasks[@]}"; do
+    if (( i % MAX_PARALLEL == worker_id )); then
+      run_task "${tasks[$i]}" "$gpu"
+    fi
+  done
+}
+
+echo "LOG_ROOT=$LOG_ROOT"
+for ((worker_id=0; worker_id<MAX_PARALLEL; worker_id++)); do
+  gpu="$worker_id"
+  worker "$worker_id" "$gpu" >"$LOG_ROOT/worker${worker_id}_gpu${gpu}.log" 2>&1 &
+done
+wait
+
+python scripts/TimeDiff/summarize_fresh_timediff_sparc_pit.py \
+  --seeds "$SEEDS" \
+  --windows "$WINDOWS" \
+  --horizon "$HORIZON" \
+  --output "$LOG_ROOT/summary_fresh_timediff_sparc_pit.csv"
+cp "$LOG_ROOT/summary_fresh_timediff_sparc_pit.csv" logs/fresh_timediff_sparc_pit_latest.csv
+
+echo "[$(date)] fresh TimeDiff/SPARC-PIT finished"
+echo "summary=$LOG_ROOT/summary_fresh_timediff_sparc_pit.csv"
